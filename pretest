	function Window:CreateTab(name, icon)
		local isFirst = next(self.Tabs) == nil

		local TabBtn = New("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = isFirst and T.PanelLight or T.Panel,
			Size = UDim2.new(0, 40, 0, 40),
			Parent = Sidebar,
		})
		AddCorner(TabBtn, 10)
		local tabStroke = New("UIStroke", { Color = T.Accent2, Thickness = 1, Transparency = isFirst and 0.4 or 1 })
		tabStroke.Parent = TabBtn

		-- fall back to the tab name's first letter if no icon given
		local iconObj
		if icon and icon ~= "" then
			iconObj = New("ImageLabel", {
				Image = icon,
				ImageColor3 = isFirst and T.Text or T.SubText,
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 20, 0, 20),
				Position = UDim2.new(0.5, -10, 0.5, -10),
				Parent = TabBtn,
			})
		else
			iconObj = New("TextLabel", {
				Text = string.sub(name or "?", 1, 1):upper(),
				Font = Enum.Font.GothamBold,
				TextSize = 16,
				TextColor3 = isFirst and T.Text or T.SubText,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				Parent = TabBtn,
			})
		end

		local function TintIcon(obj, color)
			if obj:IsA("ImageLabel") then
				Tween(obj, EASE, { ImageColor3 = color })
			else
				Tween(obj, EASE, { TextColor3 = color })
			end
		end

		TabBtn.MouseEnter:Connect(function()
			Tooltip.Text = name
			Tooltip.Visible = true
			local pos = TabBtn.AbsolutePosition
			Tooltip.Position = UDim2.new(
				0, pos.X + TabBtn.AbsoluteSize.X + 10,
				0, pos.Y + TabBtn.AbsoluteSize.Y / 2 - 13
			)
		end)
		TabBtn.MouseLeave:Connect(function()
			Tooltip.Visible = false
		end)

		local Page = New("ScrollingFrame", {
			Size = UDim2.new(1, -20, 1, -16),
			Position = UDim2.new(0, 10, 0, 8),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = T.Accent2,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = isFirst,
			Parent = Content,
		})
		New("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}).Parent = Page

		local Tab = { Button = TabBtn, Page = Page, Icon = iconObj }

		TabBtn.MouseButton1Click:Connect(function()
			for _, t in pairs(Window.Tabs) do
				Tween(t.Button, EASE, { BackgroundColor3 = T.Panel })
				Tween(t.Stroke, EASE, { Transparency = 1 })
				TintIcon(t.Icon, T.SubText)
				t.Page.Visible = false
			end
			Tween(TabBtn, EASE, { BackgroundColor3 = T.PanelLight })
			Tween(tabStroke, EASE, { Transparency = 0.4 })
			TintIcon(iconObj, T.Text)
			Page.Visible = true
		end)

		TabBtn.MouseEnter:Connect(function()
			if not Page.Visible then
				Tween(TabBtn, EASE, { BackgroundColor3 = T.PanelLight })
			end
		end)
		TabBtn.MouseLeave:Connect(function()
			if not Page.Visible then
				Tween(TabBtn, EASE, { BackgroundColor3 = T.Panel })
			end
		end)

		Tab.Stroke = tabStroke
		Window.Tabs[#Window.Tabs + 1] = Tab

		--=================================================
		-- ELEMENTS (scoped to this tab's Page)
		--=================================================
		local Elements = {}

