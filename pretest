    local function openPicker(anchorRow)
        if not pickerGetNames then return end
        rebuildPicker()
        local ap     = anchorRow.AbsolutePosition
        local as     = anchorRow.AbsoluteSize
        local names  = pickerGetNames()
        local ROW_PX = 30
        local PAD_PX = 10
        local idealH = #names * ROW_PX + PAD_PX
        local panelH = math.min(idealH, 200)
        local screenH = workspace.CurrentCamera.ViewportSize.Y
        local posY = ap.Y + as.Y + 4
        if posY + panelH > screenH - 10 then posY = ap.Y - panelH - 4 end
        pickerPanel.Position = UDim2.new(0, ap.X, 0, posY)
        pickerPanel.Size     = UDim2.new(0, 220, 0, panelH)
        pickerPanel.Visible  = true
        pickerOpen           = true
    end

    -- Outside-click close for picker panel.
    -- task.defer lets row MouseButton1Click fire first before checking.
    UserInputService.InputBegan:Connect(function(input)
        if not pickerOpen then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        -- Use input.Position (screen coords) — matches AbsolutePosition
        -- for IgnoreGuiInset=true. GetMouseLocation() has a ~36px Y offset.
        local mouse = input.Position
        task.defer(function()
            if not pickerOpen then return end
            local ap = pickerPanel.AbsolutePosition
            local as = pickerPanel.AbsoluteSize
            local scrollH = math.max(as.Y, pickerScroll.AbsoluteCanvasSize.Y)
            local inside = mouse.X >= ap.X and mouse.X <= ap.X + as.X
                        and mouse.Y >= ap.Y and mouse.Y <= ap.Y + scrollH
            if not inside then closePicker() end
        end)
    end)

    -- Outside-click close for ALL regular dropdowns.
    -- activeDropClose holds the closeD fn of whichever dropdown is open.
    -- task.defer so the dropdown's own click handler fires first.
    UserInputService.InputBegan:Connect(function(input)
        if not activeDropClose then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        -- Use input.Position (screen coords) to match AbsolutePosition
        local mouse = input.Position
        task.defer(function()
            if not activeDropClose then return end
            local inside = false
            for _, dp in ipairs(dropOverlay:GetChildren()) do
                if dp:IsA("ScrollingFrame") and dp.Visible then
                    local ap      = dp.AbsolutePosition
                    local as      = dp.AbsoluteSize
                    local canvasH = math.max(as.Y, dp.AbsoluteCanvasSize.Y)
                    if mouse.X >= ap.X and mouse.X <= ap.X + as.X
                    and mouse.Y >= ap.Y and mouse.Y <= ap.Y + canvasH then
                        inside = true; break
                    end
                end
            end
            if not inside then
                activeDropClose()
                activeDropClose = nil
            end
        end)
    end)

