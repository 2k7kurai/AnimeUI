------------------------------------------------------------------------
-- HELPERS
------------------------------------------------------------------------
local T

local function tw(obj, t, props, style)
    TweenService:Create(obj,
        TweenInfo.new(t, style or Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        props):Play()
end
local function corner(obj, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r or 8); c.Parent = obj; return c
end
local function pillCorner(obj)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = obj
end
local function stroke(obj, col, thick)
    local s = Instance.new("UIStroke")
    s.Color = col or Color3.fromRGB(35,38,58); s.Thickness = thick or 1; s.Parent = obj; return s
end
local function pad(obj, t, b, l, r)
    local p = Instance.new("UIPadding")
    p.PaddingTop=UDim.new(0,t or 8); p.PaddingBottom=UDim.new(0,b or 8)
    p.PaddingLeft=UDim.new(0,l or 8); p.PaddingRight=UDim.new(0,r or 8); p.Parent=obj
end
local function lbl(parent, text, sz, col, font, xA, zi)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency=1; l.Text=text or ""; l.TextSize=sz or 13
    l.TextColor3=col or Color3.fromRGB(230,232,245); l.Font=font or Enum.Font.Gotham
    l.TextXAlignment=xA or Enum.TextXAlignment.Left; l.ZIndex=zi or 8
    l.RichText=true; l.Parent=parent; return l
end
local function fsWrite(p,d) pcall(writefile,p,d) end
local function fsRead(p)  local ok,v=pcall(readfile,p);  return ok and v or nil end
local function fsMkdir(p) pcall(makefolder,p) end
local function fsIs(p)    local ok,v=pcall(isfile,p);    return ok and v end
local function fsList(p)  local ok,v=pcall(listfiles,p); return ok and v or {} end
local function fsDel(p)   pcall(delfile,p) end

local function loadSettings()
    local r = fsRead(SETTINGS_FILE)
    if r then
        local ok,d = pcall(function() return HttpService:JSONDecode(r) end)
        if ok and type(d)=="table" then return d end
    end
    return {}
end
local function saveSettings(d)
    fsMkdir("ZenithImmortal")
    local ok,e = pcall(function() return HttpService:JSONEncode(d) end)
    if ok then fsWrite(SETTINGS_FILE, e) end
end

