    function Window:CreateTab(name, iconId)
        if not self._alive then return {} end
        Window._tabCount+=1; local idx=Window._tabCount

        local tabBtn=Instance.new("ImageButton"); tabBtn.Name="TabBtn_"..name
        tabBtn.Size=UDim2.new(0,BTN_SZ,0,BTN_SZ); tabBtn.BackgroundColor3=T.SectionBG
        tabBtn.Image=iconId or ""; tabBtn.ImageColor3=Color3.new(1,1,1)
        tabBtn.ImageTransparency=0.25; tabBtn.ScaleType=Enum.ScaleType.Fit
        tabBtn.AutoButtonColor=false; tabBtn.LayoutOrder=idx
        tabBtn.ZIndex=Z.Sidebar+2; tabBtn.Parent=sbHolder
        corner(tabBtn,8); local tabS=stroke(tabBtn,T.Stroke,1.5)

        local activeBar=Instance.new("Frame"); activeBar.Size=UDim2.new(0,3,0,18)
        activeBar.AnchorPoint=Vector2.new(0,0.5); activeBar.Position=UDim2.new(0,-8,0.5,0)
        activeBar.BackgroundColor3=T.Accent; activeBar.BorderSizePixel=0
        activeBar.Visible=false; activeBar.ZIndex=Z.Sidebar+3; activeBar.Parent=tabBtn
        pillCorner(activeBar)

        local function makeCol(xScale)
            local sf=Instance.new("ScrollingFrame")
            sf.Size=UDim2.new(0.5,-1,1,0)
            sf.Position=UDim2.new(xScale, xScale>0 and 1 or 0, 0, 0)
            sf.BackgroundTransparency=1; sf.ScrollBarThickness=3
            sf.ScrollBarImageColor3=T.Accent; sf.ScrollBarImageTransparency=0.5
            -- AutomaticCanvasSize doesn't chain through nested AutomaticSize frames,
            -- so we drive CanvasSize manually from the layout's AbsoluteContentSize.
            sf.CanvasSize=UDim2.new(0,0,0,0)
            sf.AutomaticCanvasSize=Enum.AutomaticSize.None
            sf.ClipsDescendants=true; sf.Visible=false; sf.ZIndex=Z.Controls; sf.Parent=contentArea
            pad(sf,8,8,8,8)
            local ll=Instance.new("UIListLayout"); ll.FillDirection=Enum.FillDirection.Vertical
            ll.Padding=UDim.new(0,6); ll.SortOrder=Enum.SortOrder.LayoutOrder; ll.Parent=sf

            -- Keep CanvasSize in sync whenever layout content changes size
            local PAD_V = 16  -- top + bottom padding (8+8)
            local function syncCanvas()
                sf.CanvasSize=UDim2.new(0,0,0,ll.AbsoluteContentSize.Y + PAD_V)
            end
            ll:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(syncCanvas)
            syncCanvas()

            return sf
        end
        local leftCol=makeCol(0); local rightCol=makeCol(0.5)
        local tabCols={Left=leftCol, Right=rightCol}

        local function activate()
            for _,ch in ipairs(contentArea:GetChildren()) do
                if ch:IsA("ScrollingFrame") then ch.Visible=false end
            end
            for _,b in ipairs(sbHolder:GetChildren()) do
                if b:IsA("ImageButton") then
                    tw(b,0.15,{BackgroundColor3=T.SectionBG,ImageTransparency=0.25})
                    local s=b:FindFirstChildOfClass("UIStroke")
                    if s then tw(s,0.15,{Color=T.Stroke}) end
                    local ab=b:FindFirstChildOfClass("Frame")
                    if ab then ab.Visible=false end
                end
            end
            leftCol.Visible=true; rightCol.Visible=true
            tw(tabBtn,0.18,{BackgroundColor3=T.AccentDim,ImageTransparency=0})
            tw(tabS,0.18,{Color=T.Accent}); activeBar.Visible=true; Window._active=name
        end

        tabBtn.MouseButton1Click:Connect(activate)
        tabBtn.MouseEnter:Connect(function()
            showTip(tabBtn,name)
            if Window._active~=name then
                tw(tabBtn,0.11,{BackgroundColor3=T.SectionHdr,ImageTransparency=0.1})
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            hideTip()
            if Window._active~=name then
                tw(tabBtn,0.11,{BackgroundColor3=T.SectionBG,ImageTransparency=0.25})
            end
        end)
        if idx==1 then task.defer(activate) end

        local Tab={}
        local colOrd={Left=0,Right=0}
        local function nextOrd(col) colOrd[col]=(colOrd[col] or 0)+1; return colOrd[col] end
        local currentBox={Left=nil,Right=nil}
        local rowOrd={Left=0,Right=0}

        function Tab:AddSection(title,col)
            col=col or "Left"; local page=tabCols[col]

            -- Outer box stacks its children (header + inner + spacer) via UIListLayout
            -- so AutomaticSize.Y correctly totals their heights.
            local box=Instance.new("Frame"); box.Name="Section_"..title
            box.Size=UDim2.new(1,0,0,0); box.AutomaticSize=Enum.AutomaticSize.Y
            box.BackgroundColor3=T.SectionBG; box.LayoutOrder=nextOrd(col)
            box.ZIndex=Z.Controls; box.Parent=page
            corner(box,8); stroke(box,T.Stroke,1)
            -- Stack header, rows, spacer top-to-bottom inside the box
            local boxLayout=Instance.new("UIListLayout")
            boxLayout.FillDirection=Enum.FillDirection.Vertical
            boxLayout.Padding=UDim.new(0,0)
            boxLayout.SortOrder=Enum.SortOrder.LayoutOrder
            boxLayout.Parent=box

            -- Header strip (LayoutOrder=1, fixed height)
            local hdr=Instance.new("Frame"); hdr.Name="SectionHeader"
            hdr.Size=UDim2.new(1,0,0,SEC_HDR_H); hdr.BackgroundColor3=T.SectionHdr
            hdr.BorderSizePixel=0; hdr.ZIndex=Z.Controls+1; hdr.LayoutOrder=1; hdr.Parent=box
            -- Only round the top two corners of the header so it blends into the box body
            local hdrC=Instance.new("UICorner"); hdrC.CornerRadius=UDim.new(0,8); hdrC.Parent=hdr
            local dot=Instance.new("Frame"); dot.Size=UDim2.new(0,3,0,14)
            dot.Position=UDim2.new(0,8,0.5,-7); dot.BackgroundColor3=T.Accent
            dot.BorderSizePixel=0; dot.ZIndex=Z.Controls+2; dot.Parent=hdr; corner(dot,2)
            local hl=lbl(hdr,(title or ""):upper(),10,T.Accent,
                Enum.Font.GothamBold,Enum.TextXAlignment.Left,Z.Controls+2)
            hl.Size=UDim2.new(1,-24,1,0); hl.Position=UDim2.new(0,18,0,0)

            -- Inner frame holds all control rows, grows with them (LayoutOrder=2)
            local inner=Instance.new("Frame"); inner.Name="Inner"
            inner.Size=UDim2.new(1,0,0,0); inner.AutomaticSize=Enum.AutomaticSize.Y
            inner.BackgroundTransparency=1; inner.ZIndex=Z.Controls
            inner.LayoutOrder=2; inner.Parent=box
            local il=Instance.new("UIListLayout"); il.FillDirection=Enum.FillDirection.Vertical
            il.Padding=UDim.new(0,0); il.SortOrder=Enum.SortOrder.LayoutOrder; il.Parent=inner

            -- Bottom spacer (LayoutOrder=3): provides the 6px gap before the
            -- rounded corners so the last row never bleeds to the box edge.
            local bottomSpacer=Instance.new("Frame")
            bottomSpacer.Name="BottomSpacer"
            bottomSpacer.Size=UDim2.new(1,0,0,6)
            bottomSpacer.BackgroundTransparency=1
            bottomSpacer.LayoutOrder=3
            bottomSpacer.ZIndex=Z.Controls
            bottomSpacer.Parent=box

            currentBox[col]=inner; rowOrd[col]=0
        end

        local function makeRow(col,h)
            if not currentBox[col] then Tab:AddSection("",col) end
            rowOrd[col]=(rowOrd[col] or 0)+1
            local row=Instance.new("Frame"); row.Size=UDim2.new(1,0,0,h or ROW_H)
            row.BackgroundColor3=T.Row; row.LayoutOrder=rowOrd[col]
            row.ZIndex=Z.Controls; row.Parent=currentBox[col]
            -- Divider between rows — hidden on the very last row because the
            -- bottom spacer sits after it, so visually it's never the last child.
            local div=Instance.new("Frame"); div.Size=UDim2.new(1,0,0,1); div.Position=UDim2.new(0,0,1,-1)
            div.BackgroundColor3=T.Stroke; div.BorderSizePixel=0; div.ZIndex=Z.Controls+1; div.Parent=row
            return row
        end

