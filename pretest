		function Elements:CreateToggle(opts)
			opts = opts or {}
			local state = opts.Default or false
			local Row = New("Frame", {
				BackgroundColor3 = T.PanelLight,
				Size = UDim2.new(1, 0, 0, 36),
				Parent = Page,
			})
