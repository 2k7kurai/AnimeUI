            local chev=lbl(selB,"▾",10,T.TextMuted,Enum.Font.GothamBold,Enum.TextXAlignment.Right,Z.Controls+2)
            chev.Size=UDim2.new(1,-2,1,0)
            local dp=Instance.new("ScrollingFrame"); dp.Size=UDim2.new(0,0,0,0)
            dp.BackgroundColor3=T.Panel; dp.ClipsDescendants=true; dp.Active=true
            dp.ZIndex=Z.Dropdown; dp.Visible=false; dp.ScrollBarThickness=3
            dp.ScrollBarImageColor3=T.Accent; dp.ScrollBarImageTransparency=0.4
            dp.CanvasSize=UDim2.new(0,0,0,0); dp.AutomaticCanvasSize=Enum.AutomaticSize.Y
            dp.ScrollingDirection=Enum.ScrollingDirection.Y; dp.Parent=dropOverlay
            corner(dp,6); stroke(dp,T.Accent,1); pad(dp,3,3,3,3)
            local dpL=Instance.new("UIListLayout"); dpL.Padding=UDim.new(0,2)
            dpL.SortOrder=Enum.SortOrder.LayoutOrder; dpL.Parent=dp
            local function closeD()
                if not open2 then return end; open2=false
                activeDropClose=nil
                tw(dp,0.12,{Size=UDim2.new(0,dp.AbsoluteSize.X,0,0)})
                task.delay(0.13,function() dp.Visible=false end); tw(chev,0.12,{Rotation=0})
            end
            local function buildOpts()
                for _,ch in pairs(dp:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
                for i,opt in ipairs(opts) do
                    local ob=Instance.new("TextButton"); ob.Size=UDim2.new(1,0,0,22)
                    ob.BackgroundColor3=T.SectionBG; ob.Text=opt
                    ob.TextColor3=opt==sel and T.Accent or T.Text
                    ob.Font=Enum.Font.Gotham; ob.TextSize=11; ob.AutoButtonColor=false
                    ob.LayoutOrder=i; ob.ZIndex=Z.Dropdown+1; ob.Parent=dp; corner(ob,4)
                    ob.MouseEnter:Connect(function() tw(ob,0.08,{BackgroundColor3=T.SectionHdr,TextColor3=T.AccentGlow}) end)
                    ob.MouseLeave:Connect(function() tw(ob,0.08,{BackgroundColor3=T.SectionBG,TextColor3=opt==sel and T.Accent or T.Text}) end)
                    ob.MouseButton1Click:Connect(function()
                        if not Window._alive then return end
                        -- task.defer: let InputBegan outside-click fire first,
                        -- then process the selection so it isn't double-closed
                        task.defer(function()
                            sel=opt; selB.Text=opt; closeD(); buildOpts()
                            if c2.Callback then c2.Callback(opt) end
                        end)
                    end)
                end
            end
            buildOpts()
            selB.MouseButton1Click:Connect(function()
                if not Window._alive then return end
                if open2 then closeD(); return end
                if activeDropClose and activeDropClose~=closeD then activeDropClose() end
                open2=true; activeDropClose=closeD
                local ap=selB.AbsolutePosition; local as=selB.AbsoluteSize
                local pw=as.X+4
                local sv=workspace.CurrentCamera.ViewportSize.Y
                local idealH=#opts*26+8
                local spaceBelow=sv-(ap.Y+as.Y)-10
                local spaceAbove=ap.Y-10
                local ph,up
                if spaceBelow>=math.min(idealH,80) or spaceBelow>=spaceAbove then
                    ph=math.min(idealH,spaceBelow); up=false
                else
                    ph=math.min(idealH,spaceAbove); up=true
                end
                ph=math.max(ph,30)
                buildOpts()
                dp.Size=UDim2.new(0,pw,0,0); dp.CanvasPosition=Vector2.zero
                dp.Position=up and UDim2.new(0,ap.X,0,ap.Y-ph-4) or UDim2.new(0,ap.X,0,ap.Y+as.Y+4)
                dp.Visible=true; tw(dp,0.15,{Size=UDim2.new(0,pw,0,ph)}); tw(chev,0.15,{Rotation=180})
            end)
            addTooltip(row, c2.Tooltip)
            table.insert(allSectionBoxes,{row=row,nameLbl=nm})
            local DD={}
            function DD:Set(v) sel=v; selB.Text=v; buildOpts() end
            function DD:Get() return sel end
            function DD:SetOptions(o) opts=o; buildOpts() end
            if c2.Flag then Window.Flags[c2.Flag]={Type="Dropdown",Set=DD.Set,Get=DD.Get} end
            return DD
        end

