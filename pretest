        -- AddEnemyPicker: button row that opens the multi-select panel
        function Tab:AddEnemyPicker(c2)
            c2 = c2 or {}
            local col      = c2.Col or "Left"
            local selected = c2.Selected   -- { [name]=true } passed by reference
            local getNames = c2.GetNames
            local row      = makeRow(col, ROW_H)

            local nm=lbl(row, c2.Name or "Select Enemies", 12, T.Text,
                Enum.Font.GothamSemibold, Enum.TextXAlignment.Left, Z.Controls+1)
            nm.Name="NameLabel"; nm.Size=UDim2.new(1,-28,1,0); nm.Position=UDim2.new(0,10,0,0)

            local arr=lbl(row,"▾",11,T.Accent,Enum.Font.GothamBold,Enum.TextXAlignment.Right,Z.Controls+1)
            arr.Size=UDim2.new(0,18,1,0); arr.Position=UDim2.new(1,-22,0,0)

            local function countSel()
                local n=0; for _,v in pairs(selected) do if v then n+=1 end end; return n
            end
            local function updateLabel()
                local n=countSel()
                nm.Text = n>0 and (c2.Name or "Select Enemies").." ("..n..")" or (c2.Name or "Select Enemies")
            end

            -- Store this picker's own data in upvalues so each picker
            -- wires itself on open instead of at creation.
            -- This allows multiple AddEnemyPicker calls without them
            -- overwriting each other's Selected/GetNames references.
            local myGetNames = getNames
            local mySelected  = selected
            local myOnChange  = c2.OnChange

            local btn=Instance.new("TextButton"); btn.Size=UDim2.new(1,0,1,0)
            btn.BackgroundTransparency=1; btn.Text=""; btn.ZIndex=Z.Controls+3; btn.Parent=row

            btn.MouseEnter:Connect(function() tw(row,0.1,{BackgroundColor3=T.RowHover}); tw(arr,0.1,{TextColor3=T.AccentGlow}) end)
            btn.MouseLeave:Connect(function() tw(row,0.1,{BackgroundColor3=T.Row}); tw(arr,0.1,{TextColor3=T.Accent}) end)
            btn.MouseButton1Click:Connect(function()
                if pickerAPI.isOpen() then
                    pickerAPI.close(); tw(arr,0.12,{Rotation=0})
                else
                    -- Wire THIS picker's data right before opening
                    pickerAPI.setup(myGetNames, mySelected, function()
                        updateLabel()
                        if myOnChange then myOnChange(mySelected) end
                    end)
                    pickerAPI.open(row); tw(arr,0.12,{Rotation=180})
                end
            end)

            table.insert(allSectionBoxes,{row=row,nameLbl=nm})
            return { UpdateLabel=updateLabel }
        end

        return Tab
