--=========================================================
function Aurora:CreateWindow(config)
	config = config or {}
	local themeName = config.Theme or "Sakura"
	local T = Themes[themeName] or Themes.Sakura

	-- Destroy any previous instance so re-running the script doesn't stack UIs
	local existing = PlayerGui:FindFirstChild("AuroraUI")
	if existing then existing:Destroy() end

	local ScreenGui = New("ScreenGui", {
		Name = "AuroraUI",
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = PlayerGui,
	})

	local Main = New("Frame", {
		Name = "Main",
		Size = UDim2.new(0, 560, 0, 380),
		Position = UDim2.new(0.5, -280, 0.5, -190),
		BackgroundColor3 = T.Background,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		Parent = ScreenGui,
	})
	AddCorner(Main, 14)
	New("UIStroke", { Color = T.Stroke, Thickness = 1, Transparency = 0.3 }).Parent = Main
	AddOuterGlow(Main, T.Accent2, 60)

	-- subtle diagonal gradient overlay on the whole window for depth
	local bgGrad = AddGradient(Main, ColorSequence.new({
		ColorSequenceKeypoint.new(0, T.Background),
		ColorSequenceKeypoint.new(1, T.Panel),
	}), 60)

	-- TOP BAR
	local TopBar = New("Frame", {
		Name = "TopBar",
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundColor3 = T.Panel,
		BorderSizePixel = 0,
		Parent = Main,
	})
	AddCorner(TopBar, 14)
	-- mask the bottom corners of the topbar so it looks flush, not pill-shaped
	New("Frame", {
		Size = UDim2.new(1, 0, 0, 14),
		Position = UDim2.new(0, 0, 1, -14),
		BackgroundColor3 = T.Panel,
		BorderSizePixel = 0,
		Parent = TopBar,
	})

	local accentBar = New("Frame", {
		Size = UDim2.new(0, 4, 0, 26),
		Position = UDim2.new(0, 14, 0.5, -13),
		BackgroundColor3 = T.Accent1,
		BorderSizePixel = 0,
		Parent = TopBar,
	})
	AddCorner(accentBar, 2)
	AddGradient(accentBar, ColorSequence.new(T.Accent1, T.Accent3), 90)

	New("TextLabel", {
		Text = config.Title or "AuroraUI",
		Font = Enum.Font.GothamBold,
		TextSize = 17,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 260, 0, 20),
		Position = UDim2.new(0, 28, 0, 8),
		Parent = TopBar,
	})
	New("TextLabel", {
		Text = config.SubTitle or "",
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = T.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 260, 0, 16),
		Position = UDim2.new(0, 28, 0, 27),
		Parent = TopBar,
	})

	local CloseBtn = New("TextButton", {
		Text = "×",
		Font = Enum.Font.GothamBold,
		TextSize = 20,
		TextColor3 = T.SubText,
		BackgroundColor3 = T.PanelLight,
		Size = UDim2.new(0, 28, 0, 28),
		Position = UDim2.new(1, -40, 0.5, -14),
		Parent = TopBar,
	})
	AddCorner(CloseBtn, 8)
	AddHoverEffect(CloseBtn, T.PanelLight, T.Accent2)
	CloseBtn.MouseButton1Click:Connect(function()
		Tween(Main, EASE_SLOW, { Size = UDim2.new(0, 560, 0, 0), Position = Main.Position + UDim2.new(0, 0, 0, 190) })
		task.delay(0.45, function() ScreenGui:Destroy() end)
	end)

	local MinBtn = New("TextButton", {
		Text = "–",
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = T.SubText,
		BackgroundColor3 = T.PanelLight,
		Size = UDim2.new(0, 28, 0, 28),
		Position = UDim2.new(1, -76, 0.5, -14),
		Parent = TopBar,
	})
	AddCorner(MinBtn, 8)
	AddHoverEffect(MinBtn, T.PanelLight, T.Accent3)

	MakeDraggable(TopBar, Main)

	-- SIDEBAR (tabs)
	local Sidebar = New("Frame", {
		Name = "Sidebar",
		Size = UDim2.new(0, 140, 1, -50),
		Position = UDim2.new(0, 0, 0, 50),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Parent = Main,
	})
	local TabList = New("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
	TabList.Parent = Sidebar
	New("UIPadding", {
		PaddingTop = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 10),
		PaddingRight = UDim.new(0, 10),
	}).Parent = Sidebar

	-- CONTENT AREA
	local Content = New("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -140, 1, -50),
		Position = UDim2.new(0, 140, 0, 50),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Parent = Main,
	})

	-- NOTIFICATIONS holder (top-right of screen, independent of Main)
	local NotifHolder = New("Frame", {
		Name = "Notifications",
		Size = UDim2.new(0, 300, 1, -20),
		Position = UDim2.new(1, -320, 0, 10),
		BackgroundTransparency = 1,
		Parent = ScreenGui,
	})
	New("UIListLayout", {
		Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}).Parent = NotifHolder

	local Window = setmetatable({}, { __index = {} })
	Window.Gui = ScreenGui
	Window.Main = Main
	Window.Theme = T
	Window.Tabs = {}
	Window._firstTab = nil

	-- toggle UI visibility with Right Shift by default
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == (config.ToggleKey or Enum.KeyCode.RightShift) then
			Main.Visible = not Main.Visible
		end
	end)

	function Window:Notify(opts)
		opts = opts or {}
		local card = New("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = T.Panel,
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = NotifHolder,
		})
		AddCorner(card, 10)
		local stroke = New("UIStroke", { Color = T.Accent2, Thickness = 1, Transparency = 0.4 }).Parent
		local accent = New("Frame", {
			Size = UDim2.new(0, 3, 1, -12),
			Position = UDim2.new(0, 6, 0, 6),
			BackgroundColor3 = T.Accent1,
			BorderSizePixel = 0,
			Parent = card,
		})
		AddCorner(accent, 2)
		New("TextLabel", {
			Text = opts.Title or "Notification",
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			TextColor3 = T.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -24, 0, 18),
			Position = UDim2.new(0, 16, 0, 8),
			Parent = card,
		})
		New("TextLabel", {
			Text = opts.Content or "",
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = T.SubText,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -24, 0, 32),
			Position = UDim2.new(0, 16, 0, 26),
			Parent = card,
		})
		local targetHeight = 66
		Tween(card, EASE_SLOW, { Size = UDim2.new(1, 0, 0, targetHeight) })
		task.delay(opts.Duration or 4, function()
			if card and card.Parent then
				Tween(card, EASE, { Size = UDim2.new(1, 0, 0, 0) })
				task.delay(0.25, function() if card then card:Destroy() end end)
			end
		end)
	end

	function Window:CreateTab(name, icon)
		local isFirst = next(self.Tabs) == nil

		local TabBtn = New("TextButton", {
			Text = "",
			AutoButtonColor = false,
			BackgroundColor3 = isFirst and T.PanelLight or T.Panel,
			Size = UDim2.new(1, 0, 0, 34),
			Parent = Sidebar,
		})
		AddCorner(TabBtn, 8)
		local tabStroke = New("UIStroke", { Color = T.Accent2, Thickness = 1, Transparency = isFirst and 0.4 or 1 })
		tabStroke.Parent = TabBtn

		if icon then
			New("ImageLabel", {
				Image = icon,
				ImageColor3 = T.Text,
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 16, 0, 16),
				Position = UDim2.new(0, 8, 0.5, -8),
				Parent = TabBtn,
			})
		end
		local label = New("TextLabel", {
			Text = name,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			TextColor3 = isFirst and T.Text or T.SubText,
			BackgroundTransparency = 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -(icon and 32 or 14), 1, 0),
			Position = UDim2.new(0, icon and 30 or 12, 0, 0),
			Parent = TabBtn,
		})

		local Page = New("ScrollingFrame", {
			Size = UDim2.new(1, -20, 1, -16),
			Position = UDim2.new(0, 10, 0, 8),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = T.Accent2,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Visible = isFirst,
			Parent = Content,
		})
		New("UIListLayout", {
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}).Parent = Page

		local Tab = { Button = TabBtn, Page = Page }

		TabBtn.MouseButton1Click:Connect(function()
			for _, t in pairs(Window.Tabs) do
				Tween(t.Button, EASE, { BackgroundColor3 = T.Panel })
				Tween(t.Stroke, EASE, { Transparency = 1 })
				Tween(t.Label, EASE, { TextColor3 = T.SubText })
				t.Page.Visible = false
			end
			Tween(TabBtn, EASE, { BackgroundColor3 = T.PanelLight })
			Tween(tabStroke, EASE, { Transparency = 0.4 })
			Tween(label, EASE, { TextColor3 = T.Text })
			Page.Visible = true
		end)

		TabBtn.MouseEnter:Connect(function()
			if not Page.Visible then
				Tween(TabBtn, EASE, { BackgroundColor3 = T.PanelLight })
			end
		end)
		TabBtn.MouseLeave:Connect(function()
			if not Page.Visible then
				Tween(TabBtn, EASE, { BackgroundColor3 = T.Panel })
			end
		end)

		Tab.Stroke = tabStroke
		Tab.Label = label
		Window.Tabs[#Window.Tabs + 1] = Tab

		--=================================================
		-- ELEMENTS (scoped to this tab's Page)
		--=================================================
		local Elements = {}

		function Elements:CreateSection(name)
			New("TextLabel", {
				Text = name,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = T.Accent1,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 20),
				Parent = Page,
			})
		end

		function Elements:CreateLabel(text)
			New("TextLabel", {
				Text = text,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextColor3 = T.SubText,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 18),
				Parent = Page,
			})
		end

		function Elements:CreateButton(opts)
			opts = opts or {}
			local Btn = New("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = T.PanelLight,
				Size = UDim2.new(1, 0, 0, 36),
				Parent = Page,
			})
			AddCorner(Btn, 8)
			local stroke = New("UIStroke", { Color = T.Accent1, Thickness = 1, Transparency = 0.6 })
			stroke.Parent = Btn
			New("TextLabel", {
				Text = opts.Name or "Button",
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = T.Text,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -16, 1, 0),
				Position = UDim2.new(0, 12, 0, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Btn,
			})
			AddHoverEffect(Btn, T.PanelLight, T.PanelLight:Lerp(T.Accent1, 0.25), stroke)
			Btn.MouseButton1Click:Connect(function()
				if opts.Callback then opts.Callback() end
			end)
			return Btn
		end

		function Elements:CreateToggle(opts)
			opts = opts or {}
			local state = opts.Default or false
			local Row = New("Frame", {
				BackgroundColor3 = T.PanelLight,
				Size = UDim2.new(1, 0, 0, 36),
				Parent = Page,
			})
			AddCorner(Row, 8)
			New("UIStroke", { Color = T.Stroke, Thickness = 1, Transparency = 0.6 }).Parent = Row
			New("TextLabel", {
				Text = opts.Name or "Toggle",
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = T.Text,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -60, 1, 0),
				Position = UDim2.new(0, 12, 0, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Row,
			})

			local Switch = New("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = state and T.Accent1 or T.Panel,
				Size = UDim2.new(0, 40, 0, 20),
				Position = UDim2.new(1, -50, 0.5, -10),
				Parent = Row,
			})
			AddCorner(Switch, 10)
			local switchStroke = AddGlowStroke(Switch, T.Accent1, 1)
			switchStroke.Enabled = state

			local Knob = New("Frame", {
				BackgroundColor3 = T.Text,
				Size = UDim2.new(0, 16, 0, 16),
				Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
				Parent = Switch,
			})
			AddCorner(Knob, 8)

			local function render()
				Tween(Switch, EASE, { BackgroundColor3 = state and T.Accent1 or T.Panel })
				Tween(Knob, EASE, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) })
				switchStroke.Enabled = state
			end

			Switch.MouseButton1Click:Connect(function()
				state = not state
				render()
				if opts.Callback then opts.Callback(state) end
			end)
			if opts.Flag then Aurora.Flags[opts.Flag] = state end
			return { Set = function(_, v) state = v; render(); if opts.Callback then opts.Callback(state) end end }
		end

		function Elements:CreateSlider(opts)
			opts = opts or {}
			local min, max = opts.Min or 0, opts.Max or 100
			local value = math.clamp(opts.Default or min, min, max)

			local Row = New("Frame", {
				BackgroundColor3 = T.PanelLight,
				Size = UDim2.new(1, 0, 0, 46),
				Parent = Page,
			})
			AddCorner(Row, 8)
			New("UIStroke", { Color = T.Stroke, Thickness = 1, Transparency = 0.6 }).Parent = Row

			New("TextLabel", {
				Text = opts.Name or "Slider",
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = T.Text,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -70, 0, 20),
				Position = UDim2.new(0, 12, 0, 4),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Row,
			})
			local ValueLabel = New("TextLabel", {
				Text = tostring(value),
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = T.Accent1,
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 50, 0, 20),
				Position = UDim2.new(1, -60, 0, 4),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = Row,
			})

			local Track = New("Frame", {
				BackgroundColor3 = T.Panel,
				Size = UDim2.new(1, -24, 0, 6),
				Position = UDim2.new(0, 12, 1, -16),
				Parent = Row,
			})
			AddCorner(Track, 3)
			local Fill = New("Frame", {
				BackgroundColor3 = T.Accent1,
				Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
				Parent = Track,
			})
			AddCorner(Fill, 3)
			AddGradient(Fill, ColorSequence.new(T.Accent1, T.Accent3), 0)
			AddGlowStroke(Fill, T.Accent1, 1)

			local dragging = false
			local function setFromX(x)
				local rel = math.clamp((x - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
				value = math.floor(min + rel * (max - min) + 0.5)
				Fill.Size = UDim2.new(rel, 0, 1, 0)
				ValueLabel.Text = tostring(value)
				if opts.Callback then opts.Callback(value) end
			end

			Track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					setFromX(input.Position.X)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					setFromX(input.Position.X)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)
			return { Set = function(_, v) value = math.clamp(v, min, max); setFromX(Track.AbsolutePosition.X + (value-min)/(max-min)*Track.AbsoluteSize.X) end }
		end

		function Elements:CreateDropdown(opts)
			opts = opts or {}
			local options = opts.Options or {}
			local selected = opts.Default or options[1]
			local open = false

			local Row = New("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = T.PanelLight,
				Size = UDim2.new(1, 0, 0, 36),
				ClipsDescendants = true,
				Parent = Page,
			})
			AddCorner(Row, 8)
			local rowStroke = New("UIStroke", { Color = T.Stroke, Thickness = 1, Transparency = 0.6 })
			rowStroke.Parent = Row

			New("TextLabel", {
				Text = opts.Name or "Dropdown",
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = T.Text,
				BackgroundTransparency = 1,
				Size = UDim2.new(0.5, 0, 0, 36),
				Position = UDim2.new(0, 12, 0, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Row,
			})
			local SelectedLabel = New("TextLabel", {
				Text = tostring(selected),
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextColor3 = T.Accent1,
				BackgroundTransparency = 1,
				Size = UDim2.new(0.5, -34, 0, 36),
				Position = UDim2.new(0.5, 0, 0, 0),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = Row,
			})
			local Arrow = New("TextLabel", {
				Text = "▾",
				Font = Enum.Font.GothamBold,
				TextSize = 14,
				TextColor3 = T.SubText,
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 20, 0, 36),
				Position = UDim2.new(1, -24, 0, 0),
				Parent = Row,
			})

			local OptionHolder = New("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 0, 0, 40),
				Size = UDim2.new(1, 0, 0, 0),
				Parent = Row,
			})
			local OptList = New("UIListLayout", { Padding = UDim.new(0, 4) })
			OptList.Parent = OptionHolder

			for _, opt in ipairs(options) do
				local OptBtn = New("TextButton", {
					Text = tostring(opt),
					Font = Enum.Font.Gotham,
					TextSize = 12,
					TextColor3 = T.SubText,
					BackgroundColor3 = T.Panel,
					Size = UDim2.new(1, 0, 0, 26),
					Parent = OptionHolder,
				})
				AddCorner(OptBtn, 6)
				OptBtn.MouseEnter:Connect(function() Tween(OptBtn, EASE, { TextColor3 = T.Accent1 }) end)
				OptBtn.MouseLeave:Connect(function() Tween(OptBtn, EASE, { TextColor3 = T.SubText }) end)
				OptBtn.MouseButton1Click:Connect(function()
					selected = opt
					SelectedLabel.Text = tostring(opt)
					if opts.Callback then opts.Callback(opt) end
				end)
			end

			Row.MouseButton1Click:Connect(function()
				open = not open
				local targetH = open and (36 + #options * 30 + 8) or 36
				Tween(Row, EASE, { Size = UDim2.new(1, 0, 0, targetH) })
				Tween(Arrow, EASE, { Rotation = open and 180 or 0 })
				Tween(rowStroke, EASE, { Transparency = open and 0.2 or 0.6 })
				OptionHolder.Size = UDim2.new(1, 0, 0, #options * 30)
			end)
			return { Set = function(_, v) selected = v; SelectedLabel.Text = tostring(v) end }
		end

		function Elements:CreateInput(opts)
			opts = opts or {}
			local Row = New("Frame", {
				BackgroundColor3 = T.PanelLight,
				Size = UDim2.new(1, 0, 0, 36),
				Parent = Page,
			})
			AddCorner(Row, 8)
			local stroke = New("UIStroke", { Color = T.Stroke, Thickness = 1, Transparency = 0.6 })
			stroke.Parent = Row

			New("TextLabel", {
				Text = opts.Name or "",
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = T.Text,
				BackgroundTransparency = 1,
				Size = UDim2.new(0.4, 0, 1, 0),
				Position = UDim2.new(0, 12, 0, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Row,
			})
			local Box = New("TextBox", {
				Text = "",
				PlaceholderText = opts.Placeholder or "...",
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextColor3 = T.Accent1,
				PlaceholderColor3 = T.SubText,
				ClearTextOnFocus = false,
				BackgroundTransparency = 1,
				Size = UDim2.new(0.6, -16, 1, 0),
				Position = UDim2.new(0.4, 0, 0, 0),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = Row,
			})
			Box.Focused:Connect(function() Tween(stroke, EASE, { Transparency = 0.1, Color = T.Accent1 }) end)
			Box.FocusLost:Connect(function(enter)
				Tween(stroke, EASE, { Transparency = 0.6, Color = T.Stroke })
				if opts.Callback then opts.Callback(Box.Text, enter) end
			end)
			return Box
		end

		return Elements
	end

	return Window
end

return Aurora
