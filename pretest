--[[
	AuroraUI
	A standalone, anime-inspired premium UI library for Roblox scripts.
	Plug-and-play: require/loadstring this module, call AuroraUI:CreateWindow(...)
	then build Tabs -> Sections -> Elements.

	Aesthetic: dark glass panels, neon pink/purple/cyan gradients,
	animated glow strokes, tweened hover/press states, smooth page transitions.

	Usage:
		local Aurora = loadstring(game:HttpGet("PUT_YOUR_RAW_URL_HERE"))()
		local Window = Aurora:CreateWindow({
			Title = "MyScript",
			SubTitle = "v1.0",
			Theme = "Sakura", -- "Sakura" | "Cyber" | "Void"
		})

		local Tab = Window:CreateTab("Main", "rbxassetid://7733960981")

		Tab:CreateButton({ Name = "Do Thing", Callback = function() end })
		Tab:CreateToggle({ Name = "Enabled", Default = false, Callback = function(v) end })
		Tab:CreateSlider({ Name = "Speed", Min = 0, Max = 100, Default = 16, Callback = function(v) end })
		Tab:CreateDropdown({ Name = "Mode", Options = {"A","B","C"}, Default = "A", Callback = function(v) end })
		Tab:CreateInput({ Name = "Nickname", Placeholder = "Type here...", Callback = function(v) end })

		Window:Notify({ Title = "Loaded", Content = "AuroraUI is ready.", Duration = 4 })
--]]

