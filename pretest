	--=====================================================
	-- CONFIG SAVE / LOAD (persists Flag'd elements to JSON)
	--=====================================================
	function Window:SaveConfig(name)
		name = name or Window.ConfigName
		safeMakeFolder(Aurora.ConfigFolder)
		local data = {}
		for flag, obj in pairs(Window._flagObjects) do
			local ok, val = pcall(obj.Get)
			if ok then data[flag] = val end
		end
		local ok = safeWriteFile(
			Aurora.ConfigFolder .. "/" .. name .. ".json",
			game:GetService("HttpService"):JSONEncode(data)
		)
		if ok then
			Window:Notify({ Title = "Config Saved", Content = "Saved as \"" .. name .. "\"", Duration = 3 })
		else
			Window:Notify({ Title = "Save Failed", Content = "Your executor doesn't support file I/O.", Duration = 4 })
		end
		return ok
	end

	function Window:LoadConfig(name)
		name = name or Window.ConfigName
		local raw = safeReadFile(Aurora.ConfigFolder .. "/" .. name .. ".json")
		if not raw then
			Window:Notify({ Title = "No Config Found", Content = "\"" .. name .. "\" doesn't exist yet.", Duration = 3 })
			return false
		end
		local ok, data = pcall(function()
			return game:GetService("HttpService"):JSONDecode(raw)
		end)
		if not ok then return false end
		for flag, value in pairs(data) do
			local obj = Window._flagObjects[flag]
			if obj then pcall(obj.Set, value) end
		end
		Window:Notify({ Title = "Config Loaded", Content = "Loaded \"" .. name .. "\"", Duration = 3 })
		return true
	end

