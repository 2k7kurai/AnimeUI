function ZenithImmortal:CreateWindow(cfg)
    cfg = cfg or {}
    T   = self.Theme

    local WIN_W     = 760
    local WIN_H     = 490
    local SB_W      = 54
    local TOP_H     = 48
    local FOOT_H    = 24
    local BTN_SZ    = 34
    local BTN_G     = 7
    local RADIUS    = 12
    local ROW_H     = 30
    local SEC_HDR_H = 26

    local Z = {
        BG=1, Overlay=2, Sidebar=10, Content=10,
        Controls=12, Topbar=20, Footer=20,
        MiniLogo=150, Notif=200, Dropdown=500,
        EnemyPicker=510,
        Tooltip=600,
    }

    local persist         = loadSettings()
    local notifEnabled    = persist.notificationsEnabled ~= false
    local miniLogoEnabled = persist.miniLogoEnabled      ~= false
    local savedBgId       = persist.backgroundId

    local function savePersist()
        persist.notificationsEnabled = notifEnabled
        persist.miniLogoEnabled      = miniLogoEnabled
        if savedBgId then persist.backgroundId = savedBgId end
        saveSettings(persist)
    end

    -- GUI
    local gui = Instance.new("ScreenGui")
    gui.Name="ZenithImmortalUI"; gui.ResetOnSpawn=false
    gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder=999; gui.IgnoreGuiInset=true; gui.Parent=PlayerGui

    -- Main frame
    local main = Instance.new("Frame")
    main.Name="Main"; main.Size=UDim2.new(0,WIN_W,0,WIN_H)
    main.Position=UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2)
    main.BackgroundColor3=T.BG; main.ClipsDescendants=true; main.Parent=gui
    corner(main, RADIUS)

    local rimS = stroke(main, T.Accent, 1.2)
    local rimG = Instance.new("UIGradient")
    rimG.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   T.AccentDim),
        ColorSequenceKeypoint.new(0.4, T.Accent),
        ColorSequenceKeypoint.new(0.7, T.AccentGlow),
        ColorSequenceKeypoint.new(1,   T.AccentDim),
    })
    rimG.Rotation=120; rimG.Parent=rimS

    local bgImg = Instance.new("ImageLabel")
    bgImg.Size=UDim2.new(1,0,1,0); bgImg.BackgroundTransparency=1
    bgImg.Image=savedBgId and ("rbxassetid://"..savedBgId) or cfg.Background or DEFAULT_BG
    bgImg.ImageTransparency=0.55; bgImg.ScaleType=Enum.ScaleType.Crop
    bgImg.ZIndex=Z.BG; bgImg.Parent=main; corner(bgImg, RADIUS)

    local bgOv = Instance.new("Frame")
    bgOv.Size=UDim2.new(1,0,1,0); bgOv.BackgroundColor3=T.BG
    bgOv.BackgroundTransparency=0.28; bgOv.ZIndex=Z.Overlay; bgOv.Parent=main
    corner(bgOv, RADIUS)

    -- Topbar
    local topbar = Instance.new("Frame")
    topbar.Name="Topbar"; topbar.Size=UDim2.new(1,0,0,TOP_H)
    topbar.BackgroundColor3=T.Panel; topbar.BackgroundTransparency=0.06
    topbar.ZIndex=Z.Topbar; topbar.Parent=main; corner(topbar, RADIUS)

    local tl = Instance.new("Frame"); tl.Size=UDim2.new(1,0,0,1); tl.Position=UDim2.new(0,0,1,-1)
    tl.BackgroundColor3=T.Accent; tl.BorderSizePixel=0; tl.ZIndex=Z.Topbar+1; tl.Parent=topbar
    local tlG = Instance.new("UIGradient")
    tlG.Transparency=NumberSequence.new({
        NumberSequenceKeypoint.new(0,1), NumberSequenceKeypoint.new(0.15,0),
        NumberSequenceKeypoint.new(0.85,0), NumberSequenceKeypoint.new(1,1),
    }); tlG.Parent=tl

    local logoImg = Instance.new("ImageLabel")
    logoImg.Size=UDim2.new(0,26,0,26); logoImg.Position=UDim2.new(0,12,0.5,-13)
    logoImg.BackgroundTransparency=1; logoImg.Image=LOGO_ID
    logoImg.ScaleType=Enum.ScaleType.Fit; logoImg.ZIndex=Z.Topbar+2; logoImg.Parent=topbar

    local titleLbl = lbl(topbar, cfg.Name or "Zenith Immortal", 14, T.Text,
        Enum.Font.GothamBold, Enum.TextXAlignment.Left, Z.Topbar+2)
    titleLbl.Size=UDim2.new(0,190,1,0); titleLbl.Position=UDim2.new(0,44,0,0)

    local sfr = Instance.new("Frame"); sfr.Size=UDim2.new(0,210,0,28)
    sfr.AnchorPoint=Vector2.new(0.5,0.5); sfr.Position=UDim2.new(0.5,0,0.5,0)
    sfr.BackgroundColor3=T.SectionBG; sfr.ZIndex=Z.Topbar+2; sfr.Parent=topbar
    corner(sfr,7); local sfS=stroke(sfr,T.Stroke,1)
    local sIcon=lbl(sfr,"⌕",14,T.TextMuted,Enum.Font.Gotham,Enum.TextXAlignment.Left,Z.Topbar+3)
    sIcon.Size=UDim2.new(0,22,1,0); sIcon.Position=UDim2.new(0,5,0,0)
    local searchBox=Instance.new("TextBox")
    searchBox.Size=UDim2.new(1,-28,1,0); searchBox.Position=UDim2.new(0,24,0,0)
    searchBox.BackgroundTransparency=1; searchBox.Text=""
    searchBox.PlaceholderText="Search"; searchBox.PlaceholderColor3=T.TextMuted
    searchBox.TextColor3=T.Text; searchBox.Font=Enum.Font.Gotham; searchBox.TextSize=12
    searchBox.ClearTextOnFocus=false; searchBox.ZIndex=Z.Topbar+3; searchBox.Parent=sfr
    searchBox.Focused:Connect(function()  tw(sfS,0.12,{Color=T.Accent}) end)
    searchBox.FocusLost:Connect(function() tw(sfS,0.12,{Color=T.Stroke}) end)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size=UDim2.new(0,24,0,24); closeBtn.Position=UDim2.new(1,-34,0.5,-12)
    closeBtn.BackgroundColor3=T.SectionHdr; closeBtn.Text="×"; closeBtn.TextColor3=T.TextMuted
    closeBtn.Font=Enum.Font.GothamBold; closeBtn.TextSize=16; closeBtn.AutoButtonColor=false
    closeBtn.ZIndex=Z.Topbar+2; closeBtn.Parent=topbar; corner(closeBtn,6)
    closeBtn.MouseEnter:Connect(function() tw(closeBtn,0.12,{BackgroundColor3=T.Danger,TextColor3=T.Text}) end)
    closeBtn.MouseLeave:Connect(function() tw(closeBtn,0.12,{BackgroundColor3=T.SectionHdr,TextColor3=T.TextMuted}) end)

    -- Drag
    local dragOn,dragInp,dragMP,dragFP = false,nil,nil,nil
    topbar.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            dragOn=true; dragMP=i.Position; dragFP=main.Position
            i.Changed:Connect(function()
                if i.UserInputState==Enum.UserInputState.End then dragOn=false end
            end)
        end
    end)
    topbar.InputChanged:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseMovement
        or i.UserInputType==Enum.UserInputType.Touch then dragInp=i end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if i==dragInp and dragOn then
            local d=i.Position-dragMP
            local vp=workspace.CurrentCamera.ViewportSize
            local newX=math.clamp(dragFP.X.Offset+d.X, 0, vp.X-main.AbsoluteSize.X)
            local newY=math.clamp(dragFP.Y.Offset+d.Y, 0, vp.Y-main.AbsoluteSize.Y)
            main.Position=UDim2.new(0, newX, 0, newY)
        end
    end)

    -- Sidebar
    local sidebar = Instance.new("Frame"); sidebar.Name="Sidebar"
    sidebar.Size=UDim2.new(0,SB_W,1,-TOP_H-FOOT_H); sidebar.Position=UDim2.new(0,0,0,TOP_H)
    sidebar.BackgroundColor3=T.Sidebar; sidebar.BackgroundTransparency=0.04
    sidebar.ClipsDescendants=false; sidebar.ZIndex=Z.Sidebar; sidebar.Parent=main
    local sbDiv=Instance.new("Frame"); sbDiv.Size=UDim2.new(0,1,1,0); sbDiv.Position=UDim2.new(1,-1,0,0)
    sbDiv.BackgroundColor3=T.Stroke; sbDiv.BorderSizePixel=0; sbDiv.ZIndex=Z.Sidebar+1; sbDiv.Parent=sidebar
    local sbHolder=Instance.new("Frame"); sbHolder.Size=UDim2.new(1,0,1,0)
    sbHolder.BackgroundTransparency=1; sbHolder.ClipsDescendants=false
    sbHolder.ZIndex=Z.Sidebar+1; sbHolder.Parent=sidebar
    local sbList=Instance.new("UIListLayout"); sbList.FillDirection=Enum.FillDirection.Vertical
    sbList.HorizontalAlignment=Enum.HorizontalAlignment.Center
    sbList.SortOrder=Enum.SortOrder.LayoutOrder; sbList.Padding=UDim.new(0,BTN_G); sbList.Parent=sbHolder
    pad(sbHolder,10,10,0,0)

    -- Content area
    local contentArea = Instance.new("Frame"); contentArea.Name="Content"
    contentArea.Size=UDim2.new(1,-SB_W,1,-TOP_H-FOOT_H); contentArea.Position=UDim2.new(0,SB_W,0,TOP_H)
    contentArea.BackgroundTransparency=1; contentArea.ClipsDescendants=true
    contentArea.ZIndex=Z.Content; contentArea.Parent=main
    local colDiv=Instance.new("Frame"); colDiv.Size=UDim2.new(0,1,1,0); colDiv.Position=UDim2.new(0.5,0,0,0)
    colDiv.BackgroundColor3=T.Stroke; colDiv.BorderSizePixel=0
    colDiv.ZIndex=Z.Content+1; colDiv.Parent=contentArea

    -- Footer
    local footer = Instance.new("Frame"); footer.Name="Footer"
    footer.Size=UDim2.new(1,0,0,FOOT_H); footer.Position=UDim2.new(0,0,1,-FOOT_H)
    footer.BackgroundColor3=T.Footer; footer.BackgroundTransparency=0.06
    footer.ZIndex=Z.Footer; footer.Parent=main; corner(footer,RADIUS)
    local footLine=Instance.new("Frame"); footLine.Size=UDim2.new(1,0,0,1)
    footLine.BackgroundColor3=T.Stroke; footLine.BorderSizePixel=0
    footLine.ZIndex=Z.Footer+1; footLine.Parent=footer
    local discLbl=lbl(footer,"https://"..DISCORD_LINK,10,T.TextDim,
        Enum.Font.Gotham,Enum.TextXAlignment.Center,Z.Footer+2)
    discLbl.Size=UDim2.new(1,0,1,0)
    task.spawn(function()
        local hue=0
        while gui.Parent do
            hue=(hue+1)%360
            discLbl.TextColor3=Color3.fromHSV(hue/360,0.7,1)
            task.wait(0.04)
        end
    end)

    --------------------------------------------------------------------
    -- RESIZE HANDLE (bottom-right corner)
    -- A small grippy triangle in the corner. Dragging it resizes the
    -- window. Min size: 500x340. Clamped to viewport.
    --------------------------------------------------------------------
    local MIN_W, MIN_H = 500, 340
    local resizeHandle = Instance.new("TextButton")
    resizeHandle.Name              = "ResizeHandle"
    resizeHandle.Size              = UDim2.new(0, 18, 0, 18)
    resizeHandle.AnchorPoint       = Vector2.new(1, 1)
    resizeHandle.Position          = UDim2.new(1, 0, 1, 0)
    resizeHandle.BackgroundTransparency = 1
    resizeHandle.Text              = ""
    resizeHandle.AutoButtonColor   = false
    resizeHandle.ZIndex            = Z.Footer + 3
    resizeHandle.Parent            = main

    -- Draw grippy dots as a visual indicator
    local function makeGripDot(ox, oy)
        local d = Instance.new("Frame")
        d.Size             = UDim2.new(0, 2, 0, 2)
        d.Position         = UDim2.new(1, ox, 1, oy)
        d.BackgroundColor3 = T.TextMuted
        d.BorderSizePixel  = 0
        d.ZIndex           = Z.Footer + 4
        d.Parent           = main
        corner(d, 1)
    end
    makeGripDot(-4,  -4); makeGripDot(-4,  -9); makeGripDot(-4,  -14)
    makeGripDot(-9,  -4); makeGripDot(-9,  -9)
    makeGripDot(-14, -4)

    resizeHandle.MouseEnter:Connect(function()
        for _, d in ipairs(main:GetChildren()) do
            if d.Name == "" and d:IsA("Frame") and d.Size == UDim2.new(0,2,0,2) then
                tw(d, 0.1, {BackgroundColor3 = T.Accent})
            end
        end
    end)
    resizeHandle.MouseLeave:Connect(function()
        for _, d in ipairs(main:GetChildren()) do
            if d.Name == "" and d:IsA("Frame") and d.Size == UDim2.new(0,2,0,2) then
                tw(d, 0.1, {BackgroundColor3 = T.TextMuted})
            end
        end
    end)

    local resizeDragging  = false
    local resizeDragStart = nil   -- mouse position at drag start
    local resizeSizeStart = nil   -- window size at drag start

    local function applyResize(pos)
        local vp   = workspace.CurrentCamera.ViewportSize
        local dx   = pos.X - resizeDragStart.X
        local dy   = pos.Y - resizeDragStart.Y
        local newW = math.clamp(math.round(resizeSizeStart.X + dx), MIN_W, vp.X - 20)
        local newH = math.clamp(math.round(resizeSizeStart.Y + dy), MIN_H, vp.Y - 20)
        main.Size  = UDim2.new(0, newW, 0, newH)
        local ap   = main.AbsolutePosition
        main.Position = UDim2.new(0,
            math.clamp(ap.X, 0, vp.X - newW), 0,
            math.clamp(ap.Y, 0, vp.Y - newH))
        origSize = main.Size
    end

    resizeHandle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            resizeDragging  = true
            resizeDragStart = i.Position
            resizeSizeStart = main.AbsoluteSize
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then
                    resizeDragging = false
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(i)
        if not resizeDragging then return end
        if i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch then
            applyResize(i.Position)
        end
    end)

    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            resizeDragging = false
        end
    end)

    -- Dropdown overlay
    local dropOverlay=Instance.new("Frame"); dropOverlay.Size=UDim2.new(1,0,1,0)
    dropOverlay.BackgroundTransparency=1; dropOverlay.ZIndex=Z.Dropdown; dropOverlay.Parent=gui
    local activeDropClose=nil

    --------------------------------------------------------------------
    -- ENEMY PICKER PANEL  (lives in library; outside-click wired here)
    --------------------------------------------------------------------
    local pickerPanel = Instance.new("Frame")
    pickerPanel.Name  = "EnemyPickerPanel"
    pickerPanel.Size  = UDim2.new(0,220,0,0)
    pickerPanel.BackgroundColor3 = T.Panel
    pickerPanel.BorderSizePixel  = 0
    pickerPanel.ZIndex = Z.EnemyPicker
    pickerPanel.Visible = false
    pickerPanel.Parent  = gui
    corner(pickerPanel,8); stroke(pickerPanel,T.Accent,1)

    local pickerScroll = Instance.new("ScrollingFrame")
    pickerScroll.Size  = UDim2.new(1,0,1,0)
    pickerScroll.BackgroundTransparency=1
    pickerScroll.ScrollBarThickness=3; pickerScroll.ScrollBarImageColor3=T.Accent
    pickerScroll.CanvasSize=UDim2.new(0,0,0,0); pickerScroll.AutomaticCanvasSize=Enum.AutomaticSize.Y
    pickerScroll.ClipsDescendants=true; pickerScroll.ZIndex=Z.EnemyPicker+1; pickerScroll.Parent=pickerPanel
    local pickerList=Instance.new("UIListLayout")
    pickerList.Padding=UDim.new(0,1); pickerList.SortOrder=Enum.SortOrder.LayoutOrder
    pickerList.Parent=pickerScroll
    pad(pickerScroll,4,4,4,4)

    local pickerOpen     = false
    local pickerGetNames = nil
    local pickerSelected = nil
    local pickerOnChange = nil

    local function closePicker()
        pickerOpen = false
        pickerPanel.Visible = false
    end

    local function rebuildPicker()
        for _,ch in ipairs(pickerScroll:GetChildren()) do
            if ch:IsA("Frame") or ch:IsA("TextLabel") then ch:Destroy() end
        end
        if not pickerGetNames or not pickerSelected then return end
        local names = pickerGetNames()
        if #names == 0 then
            local el=Instance.new("TextLabel"); el.Size=UDim2.new(1,0,0,26)
            el.BackgroundTransparency=1; el.Text="(no enemies found)"
            el.TextColor3=T.TextMuted; el.Font=Enum.Font.Gotham; el.TextSize=11
            el.ZIndex=Z.EnemyPicker+2; el.Parent=pickerScroll; return
        end
        for i,name in ipairs(names) do
            local isOn = pickerSelected[name]==true
            local row=Instance.new("Frame"); row.Name="PR_"..name
            row.Size=UDim2.new(1,0,0,28)
            row.BackgroundColor3 = isOn and T.AccentDim or T.SectionBG
            row.BorderSizePixel=0; row.LayoutOrder=i; row.ZIndex=Z.EnemyPicker+2; row.Parent=pickerScroll
            corner(row,5)

            local check=Instance.new("TextLabel"); check.Size=UDim2.new(0,20,1,0)
            check.Position=UDim2.new(0,4,0,0); check.BackgroundTransparency=1
            check.Text=isOn and "✓" or ""; check.TextColor3=T.Accent
            check.Font=Enum.Font.GothamBold; check.TextSize=12
            check.ZIndex=Z.EnemyPicker+3; check.Parent=row

            local nl=Instance.new("TextLabel"); nl.Size=UDim2.new(1,-28,1,0)
            nl.Position=UDim2.new(0,24,0,0); nl.BackgroundTransparency=1
            nl.Text=name; nl.TextColor3=T.Text; nl.Font=Enum.Font.Gotham; nl.TextSize=12
            nl.TextXAlignment=Enum.TextXAlignment.Left; nl.ZIndex=Z.EnemyPicker+3; nl.Parent=row

            local btn=Instance.new("TextButton"); btn.Size=UDim2.new(1,0,1,0)
            btn.BackgroundTransparency=1; btn.Text=""; btn.ZIndex=Z.EnemyPicker+4; btn.Parent=row

            btn.MouseEnter:Connect(function() row.BackgroundColor3=T.RowHover end)
            btn.MouseLeave:Connect(function()
                row.BackgroundColor3 = pickerSelected[name] and T.AccentDim or T.SectionBG
            end)
            btn.MouseButton1Click:Connect(function()
