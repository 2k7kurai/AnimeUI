		function Elements:CreateKeybind(opts)
			opts = opts or {}
			local currentKey = opts.Default or Enum.KeyCode.Unknown
			local listening = false

			local Row = New("Frame", {
				BackgroundColor3 = T.PanelLight,
				Size = UDim2.new(1, 0, 0, 36),
				Parent = Page,
			})
			AddCorner(Row, 8)
			New("UIStroke", { Color = T.Stroke, Thickness = 1, Transparency = 0.6 }).Parent = Row

			local labelOffset = 12
			if opts.Icon then
				New("ImageLabel", {
					Image = opts.Icon,
					ImageColor3 = T.Accent1,
					BackgroundTransparency = 1,
					Size = UDim2.new(0, 16, 0, 16),
					Position = UDim2.new(0, 12, 0.5, -8),
					Parent = Row,
				})
				labelOffset = 36
			end

			New("TextLabel", {
				Text = opts.Name or "Keybind",
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = T.Text,
				BackgroundTransparency = 1,
				Size = UDim2.new(0.6, -labelOffset, 1, 0),
				Position = UDim2.new(0, labelOffset, 0, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Row,
			})

			local KeyBtn = New("TextButton", {
				Text = currentKey.Name,
				AutoButtonColor = false,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextColor3 = T.Accent1,
				BackgroundColor3 = T.Panel,
				Size = UDim2.new(0, 90, 0, 24),
				Position = UDim2.new(1, -100, 0.5, -12),
				Parent = Row,
			})
			AddCorner(KeyBtn, 6)
			local keyStroke = New("UIStroke", { Color = T.Accent1, Thickness = 1, Transparency = 0.6 })
			keyStroke.Parent = KeyBtn

			KeyBtn.MouseButton1Click:Connect(function()
				listening = true
				KeyBtn.Text = "..."
				Tween(keyStroke, EASE, { Transparency = 0.1 })
			end)

			UserInputService.InputBegan:Connect(function(input, gpe)
				if listening and input.UserInputType == Enum.UserInputType.Keyboard then
					currentKey = input.KeyCode
					KeyBtn.Text = currentKey.Name
					listening = false
					Tween(keyStroke, EASE, { Transparency = 0.6 })
				elseif not listening and not gpe and input.KeyCode == currentKey and currentKey ~= Enum.KeyCode.Unknown then
					if opts.Callback then opts.Callback() end
				end
			end)

			local function setKey(kc)
				if typeof(kc) == "string" then kc = Enum.KeyCode[kc] end
				if not kc then return end
				currentKey = kc
				KeyBtn.Text = kc.Name
			end

			if opts.Flag then
				Window._flagObjects[opts.Flag] = {
					Get = function() return currentKey.Name end,
					Set = setKey,
				}
			end

			table.insert(Window._keybinds, { Name = opts.Name or "Keybind", Get = function() return currentKey.Name end })

			return { Set = function(_, kc) setKey(kc) end }
		end

		return Elements
	end

	-- Name field + Save/Load buttons wired to Window:SaveConfig/LoadConfig
	function Window:CreateConfigSection(tab)
		tab:CreateSection("Configuration")
		local nameBox = tab:CreateInput({
			Name = "Config Name",
			Placeholder = Window.ConfigName,
		})
		nameBox.Text = Window.ConfigName

		local function resolveName()
			return (nameBox.Text ~= "" and nameBox.Text) or Window.ConfigName
		end

		tab:CreateButton({
			Name = "Save Config",
			Callback = function() Window:SaveConfig(resolveName()) end,
		})
		tab:CreateButton({
			Name = "Load Config",
			Callback = function() Window:LoadConfig(resolveName()) end,
		})
	end

	-- Read-only list of every keybind registered via CreateKeybind
	function Window:CreateKeybindList(tab)
		tab:CreateSection("Keybinds")
		if #Window._keybinds == 0 then
			tab:CreateLabel("No keybinds registered yet.")
			return
		end
		for _, kb in ipairs(Window._keybinds) do
			tab:CreateLabel(kb.Name .. "  →  " .. kb.Get())
		end
	end

	return Window
end

return Aurora
