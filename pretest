			})
			AddCorner(Switch, 10)
			local switchStroke = AddGlowStroke(Switch, T.Accent1, 1)
			switchStroke.Enabled = state

			local Knob = New("Frame", {
				BackgroundColor3 = T.Text,
				Size = UDim2.new(0, 16, 0, 16),
				Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
				Parent = Switch,
			})
			AddCorner(Knob, 8)

			local function render()
				Tween(Switch, EASE, { BackgroundColor3 = state and T.Accent1 or T.Panel })
				Tween(Knob, EASE, { Position = state and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8) })
				switchStroke.Enabled = state
			end

			Switch.MouseButton1Click:Connect(function()
				state = not state
				render()
				if opts.Callback then opts.Callback(state) end
			end)

			local function setState(v)
				state = v
				render()
				if opts.Callback then opts.Callback(state) end
			end
			if opts.Flag then
				Aurora.Flags[opts.Flag] = state
				Window._flagObjects[opts.Flag] = { Get = function() return state end, Set = setState }
			end
			return { Set = function(_, v) setState(v) end }
		end

		function Elements:CreateSlider(opts)
			opts = opts or {}
			local min, max = opts.Min or 0, opts.Max or 100
			local value = math.clamp(opts.Default or min, min, max)

			local Row = New("Frame", {
				BackgroundColor3 = T.PanelLight,
				Size = UDim2.new(1, 0, 0, 46),
				Parent = Page,
			})
			AddCorner(Row, 8)
			New("UIStroke", { Color = T.Stroke, Thickness = 1, Transparency = 0.6 }).Parent = Row

			New("TextLabel", {
				Text = opts.Name or "Slider",
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = T.Text,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, -70, 0, 20),
				Position = UDim2.new(0, 12, 0, 4),
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = Row,
			})
			local ValueLabel = New("TextLabel", {
				Text = tostring(value),
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = T.Accent1,
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 50, 0, 20),
				Position = UDim2.new(1, -60, 0, 4),
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = Row,
			})

			local Track = New("Frame", {
				BackgroundColor3 = T.Panel,
				Size = UDim2.new(1, -24, 0, 6),
				Position = UDim2.new(0, 12, 1, -16),
				Parent = Row,
			})
			AddCorner(Track, 3)
			local Fill = New("Frame", {
				BackgroundColor3 = T.Accent1,
				Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
				Parent = Track,
			})
			AddCorner(Fill, 3)
			AddGradient(Fill, ColorSequence.new(T.Accent1, T.Accent3), 0)
			AddGlowStroke(Fill, T.Accent1, 1)

			local dragging = false
			local function setFromX(x)
				local rel = math.clamp((x - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
				value = math.floor(min + rel * (max - min) + 0.5)
				Fill.Size = UDim2.new(rel, 0, 1, 0)
				ValueLabel.Text = tostring(value)
				if opts.Callback then opts.Callback(value) end
			end

			Track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					setFromX(input.Position.X)
				end
			end)
			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					setFromX(input.Position.X)
				end
			end)
			UserInputService.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = false
				end
			end)

			local function setValue(v)
				value = math.clamp(v, min, max)
				local rel = (value - min) / (max - min)
				Fill.Size = UDim2.new(rel, 0, 1, 0)
				ValueLabel.Text = tostring(value)
			end
			if opts.Flag then
				Window._flagObjects[opts.Flag] = { Get = function() return value end, Set = setValue }
			end
			return { Set = function(_, v) setValue(v) end }
		end

