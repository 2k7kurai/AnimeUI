        function Tab:AddDropdown(c2)
            c2=c2 or {}; local col=c2.Col or "Left"
            local opts=c2.Options or {}; local sel=c2.Default or (opts[1] or "None")
            local open2=false; local row=makeRow(col,ROW_H)
            local nm=lbl(row,c2.Name or "Dropdown",12,T.Text,
                Enum.Font.GothamSemibold,Enum.TextXAlignment.Left,Z.Controls+1)
            nm.Name="NameLabel"; nm.Size=UDim2.new(0.44,0,1,0); nm.Position=UDim2.new(0,10,0,0)
