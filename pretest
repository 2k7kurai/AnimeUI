--[[
    ZENITH IMMORTAL UI  ·  v3.1
    ─────────────────────────────────────────────────────────────────
    External library — load with:
        local ZI = loadstring(game:HttpGet("RAW_URL"))()

    Layout: two independent scroll columns (Left / Right)
    Each section = self-contained rounded box with title header.
    Accent: #538AFD
    ─────────────────────────────────────────────────────────────────
    API:
        local Win = ZI:CreateWindow({ Name="Title" })
        local Tab = Win:CreateTab("Main", ZI.Icons.Home)

        Tab:AddSection("My Section", "Left")        -- opens a box in left col
        Tab:AddToggle({ Name="X", Flag="x", Col="Left", Default=false, Callback=fn })
        Tab:AddButton({ Name="X", Col="Left", Callback=fn })
        Tab:AddDropdown({ Name="X", Col="Left", Options={}, Default="A", Callback=fn })
        Tab:AddSlider({ Name="X", Col="Left", Min=0, Max=100, Default=50, Callback=fn })
        Tab:AddInput({ Name="X", Col="Left", Placeholder="...", Callback=fn })
        Tab:AddKeybind({ Name="X", Col="Left", Default=Enum.KeyCode.F, Callback=fn })
        Tab:AddLabel("text", "Left")

        -- Multi-select enemy picker (floating checklist, outside-click closes):
        Tab:AddEnemyPicker({
            Name     = "Select Enemies",
            Col      = "Left",
            Selected = mySelectedTable,   -- { [name]=true } passed by reference
            GetNames = function() return {"EnemyA","EnemyB"} end,
            OnChange = function(sel) end, -- optional
        })

        Win:BuildSettingsUI(tab)
        Win:Notify({ Title="Hi", Content="msg", Type="success", Duration=3 })
        Win:Unload()
]]

