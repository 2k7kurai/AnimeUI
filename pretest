				OptBtn.MouseButton1Click:Connect(function()
					selected = opt
					SelectedLabel.Text = tostring(opt)
					if opts.Callback then opts.Callback(opt) end
				end)
			end

			Row.MouseButton1Click:Connect(function()
				open = not open
				local targetH = open and (36 + #options * 30 + 8) or 36
				Tween(Row, EASE, { Size = UDim2.new(1, 0, 0, targetH) })
				Tween(Arrow, EASE, { Rotation = open and 180 or 0 })
				Tween(rowStroke, EASE, { Transparency = open and 0.2 or 0.6 })
				OptionHolder.Size = UDim2.new(1, 0, 0, #options * 30)
			end)

			local function setSelected(v)
				selected = v
				SelectedLabel.Text = tostring(v)
			end
			if opts.Flag then
				Window._flagObjects[opts.Flag] = { Get = function() return selected end, Set = setSelected }
			end
			return { Set = function(_, v) setSelected(v) end }
		end

