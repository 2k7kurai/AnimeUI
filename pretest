            selB.Position=UDim2.new(0.48,0,0.5,-10); selB.BackgroundColor3=T.SectionHdr
            selB.Text=sel; selB.TextColor3=T.Accent; selB.Font=Enum.Font.GothamSemibold
            selB.TextSize=11; selB.AutoButtonColor=false; selB.ZIndex=Z.Controls+1; selB.Parent=row
