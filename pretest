			TextColor3 = T.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, -24, 0, 18),
			Position = UDim2.new(0, 16, 0, 8),
			Parent = card,
		})
		New("TextLabel", {
			Text = opts.Content or "",
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = T.SubText,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
