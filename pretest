-- Safe wrappers around executor file functions
local function safeMakeFolder(path)
	pcall(function()
		if not isfolder(path) then
			makefolder(path)
		end
	end)
end
local function safeWriteFile(path, content)
	local ok = pcall(function() writefile(path, content) end)
	return ok
end
local function safeReadFile(path)
	local ok, res = pcall(function()
		if isfile(path) then
			return readfile(path)
		end
		return nil
	end)
	if ok then return res end
	return nil
end

local function New(class, props, children)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		inst[k] = v
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	return inst
end

local function Tween(inst, info, props)
	local t = TweenService:Create(inst, info, props)
	t:Play()
	return t
end

local EASE = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local EASE_SLOW = TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local EASE_GLOW = TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

-- Pulsing glow stroke
local function AddGlowStroke(target, color, thickness)
	local stroke = New("UIStroke", {
		Color = color,
		Thickness = thickness or 1.2,
		Transparency = 0.45,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	stroke.Parent = target
	Tween(stroke, EASE_GLOW, { Transparency = 0.85 })
	return stroke
end

-- Soft radial backdrop glow
local function AddOuterGlow(target, color, size)
	local glow = New("ImageLabel", {
		Name = "OuterGlow",
		BackgroundTransparency = 1,
		Image = "rbxassetid://5028857084", -- generic soft glow radial png
		ImageColor3 = color,
		ImageTransparency = 0.75,
		ScaleType = Enum.ScaleType.Slice,
		SliceCenter = Rect.new(20, 20, 280, 280),
		Size = UDim2.new(1, size or 40, 1, size or 40),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = target.ZIndex - 1,
	})
	glow.Parent = target
	return glow
end

local function AddCorner(target, radius)
	New("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, {}).Parent = target
end

local function AddGradient(target, colorSeq, rotation)
	local grad = New("UIGradient", {
		Color = colorSeq,
		Rotation = rotation or 45,
	})
	grad.Parent = target
	return grad
end

local function MakeDraggable(dragHandle, moveTarget)
	local dragging, dragStart, startPos = false, nil, nil
	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = moveTarget.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	dragHandle.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			moveTarget.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function AddHoverEffect(button, baseColor, hoverColor, stroke)
	button.MouseEnter:Connect(function()
		Tween(button, EASE, { BackgroundColor3 = hoverColor })
		if stroke then Tween(stroke, EASE, { Transparency = 0.1 }) end
	end)
	button.MouseLeave:Connect(function()
		Tween(button, EASE, { BackgroundColor3 = baseColor })
		if stroke then Tween(stroke, EASE, { Transparency = 0.55 }) end
	end)
	button.MouseButton1Down:Connect(function()
		Tween(button, TweenInfo.new(0.08), { Size = button.Size - UDim2.new(0, 4, 0, 2) })
	end)
	button.MouseButton1Up:Connect(function()
		Tween(button, TweenInfo.new(0.12), { Size = button.Size + UDim2.new(0, 4, 0, 2) })
	end)
end

-- Drifting sakura petals
local function StartPetals(parent, T, count)
	count = count or 14
	local holder = New("Frame", {
		Name = "Petals",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		ZIndex = 0,
		Parent = parent,
	})
	for i = 1, count do
		task.spawn(function()
			task.wait(math.random() * 4)
			while holder.Parent do
				local petal = New("Frame", {
					BackgroundColor3 = (i % 2 == 0) and T.Accent1 or T.Accent2,
					BackgroundTransparency = 0.25,
					Size = UDim2.new(0, math.random(4, 7), 0, math.random(4, 7)),
					Position = UDim2.new(math.random(), 0, 0, -10),
					Rotation = math.random(0, 360),
					ZIndex = 0,
					Parent = holder,
				})
				AddCorner(petal, 4)
				local duration = math.random(7, 13)
				local endX = math.clamp(petal.Position.X.Scale + (math.random(-15, 15) / 100), -0.05, 1.05)
				Tween(petal, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
					Position = UDim2.new(endX, 0, 1, 10),
					Rotation = petal.Rotation + math.random(180, 420),
				})
				Tween(petal, TweenInfo.new(duration * 0.85, Enum.EasingStyle.Linear), { BackgroundTransparency = 1 })
				task.wait(duration)
				petal:Destroy()
				task.wait(math.random() * 2)
			end
		end)
	end
	return holder
end

