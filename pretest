	function Window:PowerLevelScan(opts)
		opts = opts or {}
		local target = opts.Target or math.random(5000, 99999)

		local overlay = New("Frame", {
			BackgroundColor3 = T.Background,
			BackgroundTransparency = 0.1,
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 50,
			Parent = Main,
		})
		AddCorner(overlay, 14)

		local numberLabel = New("TextLabel", {
			Text = "0",
			Font = Enum.Font.GothamBlack,
			TextSize = 44,
			TextColor3 = T.Accent1,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 60),
			Position = UDim2.new(0, 0, 0.4, -30),
			ZIndex = 51,
			Parent = overlay,
		})
		local caption = New("TextLabel", {
			Text = opts.Title or "SCANNING POWER LEVEL...",
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextColor3 = T.SubText,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 20),
			Position = UDim2.new(0, 0, 0.4, 34),
			ZIndex = 51,
			Parent = overlay,
		})

		task.spawn(function()
			local steps = 28
			for i = 1, steps do
				local shown = math.floor((target / steps) * i)
				numberLabel.Text = tostring(shown)
				numberLabel.Position = UDim2.new(0, math.random(-3, 3), 0.4, -30 + math.random(-2, 2))
				task.wait(0.035 + (i / steps) * 0.03) -- eases out, like it's "locking on"
			end
			numberLabel.Text = "IT'S OVER " .. tostring(target) .. "!!"
			numberLabel.Position = UDim2.new(0, 0, 0.4, -30)
			Tween(numberLabel, EASE, { TextColor3 = T.Accent2 })
			task.wait(1.2)
			Tween(overlay, EASE_SLOW, { BackgroundTransparency = 1 })
			Tween(numberLabel, EASE_SLOW, { TextTransparency = 1 })
			Tween(caption, EASE_SLOW, { TextTransparency = 1 })
			task.wait(0.45)
			overlay:Destroy()
			if opts.Callback then opts.Callback(target) end
		end)
	end

