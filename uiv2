--[[
    ╔══════════════════════════════════════════════════════════════════╗
    ║      ZENITH IMMORTAL UI  ·  v3  ·  True Layout                   ║
    ║                                                                  ║
    ║  Layout:                                                         ║
    ║    • Narrow icon-only sidebar (left)                             ║
    ║    • Topbar: logo | title | search | close                       ║
    ║    • Content: TWO independent scroll columns side-by-side        ║
    ║    • Footer: discord link                                        ║
    ║    • Sections + controls stack top→bottom inside each column     ║
    ║    • Accent: #538AFD                                             ║
    ╚══════════════════════════════════════════════════════════════════╝

    USAGE:
        local ZI  = loadstring(game:HttpGet("RAW_URL"))()
        local Win = ZI:CreateWindow({ Name="My Script" })
        local Tab = Win:CreateTab("Main", ZI.Icons.Home)

        Tab:AddSection("Combat", "Left")   -- or "Right"
        Tab:AddToggle({ Name="Auto Farm", Flag="AF", Col="Left",
                        Default=false, Callback=function(v) end })
        Tab:AddSection("Targeting", "Right")
        Tab:AddToggle({ Name="Auto M1", Flag="M1", Col="Right",
                        Default=false, Callback=function(v) end })

    All controls accept Col="Left"|"Right" (default "Left").
    AddSection(title, col) pins the header to a column.
]]

