    searchBox.PlaceholderColor3 = T.TextMuted
    searchBox.TextColor3       = T.Text
    searchBox.Font             = Enum.Font.Gotham
    searchBox.TextSize         = 12
    searchBox.ClearTextOnFocus = false
    searchBox.ZIndex           = Z.Topbar+3
    searchBox.Parent           = sfr
    searchBox.Focused:Connect(function()  tw(sfS,0.12,{Color=T.Accent}) end)
    searchBox.FocusLost:Connect(function() tw(sfS,0.12,{Color=T.Stroke}) end)

    -- Close button
    local closeBtn             = Instance.new("TextButton")
    closeBtn.Size              = UDim2.new(0,24,0,24)
    closeBtn.Position          = UDim2.new(1,-34,0.5,-12)
    closeBtn.BackgroundColor3  = T.CardHover
    closeBtn.Text              = "×"
    closeBtn.TextColor3        = T.TextMuted
    closeBtn.Font              = Enum.Font.GothamBold
    closeBtn.TextSize          = 16
    closeBtn.AutoButtonColor   = false
    closeBtn.ZIndex            = Z.Topbar+2
    closeBtn.Parent            = topbar
    corner(closeBtn,6)
    closeBtn.MouseEnter:Connect(function() tw(closeBtn,0.12,{BackgroundColor3=T.Danger,TextColor3=T.Text}) end)
    closeBtn.MouseLeave:Connect(function() tw(closeBtn,0.12,{BackgroundColor3=T.CardHover,TextColor3=T.TextMuted}) end)

    ----------------------------------------------------------------
    -- DRAG
    ----------------------------------------------------------------
    local dragOn,dragInp,dragMP,dragFP = false,nil,nil,nil
    topbar.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            dragOn=true; dragMP=i.Position; dragFP=main.Position
            i.Changed:Connect(function()
                if i.UserInputState==Enum.UserInputState.End then dragOn=false end
            end)
        end
    end)
    topbar.InputChanged:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseMovement then dragInp=i end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if i==dragInp and dragOn then
            local d=i.Position-dragMP
            main.Position=UDim2.new(dragFP.X.Scale,dragFP.X.Offset+d.X,
                                     dragFP.Y.Scale,dragFP.Y.Offset+d.Y)
        end
    end)

    ----------------------------------------------------------------
    -- SIDEBAR
    ----------------------------------------------------------------
    local sidebar              = Instance.new("Frame")
    sidebar.Name               = "Sidebar"
    sidebar.Size               = UDim2.new(0,SB_W,1,-TOP_H-FOOT_H)
    sidebar.Position           = UDim2.new(0,0,0,TOP_H)
    sidebar.BackgroundColor3   = T.Sidebar
    sidebar.BackgroundTransparency = 0.04
    sidebar.ClipsDescendants   = false
    sidebar.ZIndex             = Z.Sidebar
    sidebar.Parent             = main

    local sbDiv                = Instance.new("Frame")
    sbDiv.Size                 = UDim2.new(0,1,1,0)
    sbDiv.Position             = UDim2.new(1,-1,0,0)
    sbDiv.BackgroundColor3     = T.Stroke
    sbDiv.BorderSizePixel      = 0
    sbDiv.ZIndex               = Z.Sidebar+1
    sbDiv.Parent               = sidebar

    local sbHolder             = Instance.new("Frame")
    sbHolder.Size              = UDim2.new(1,0,1,0)
    sbHolder.BackgroundTransparency = 1
    sbHolder.ClipsDescendants  = false
    sbHolder.ZIndex            = Z.Sidebar+1
    sbHolder.Parent            = sidebar

    local sbList               = Instance.new("UIListLayout")
    sbList.FillDirection       = Enum.FillDirection.Vertical
    sbList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    sbList.SortOrder           = Enum.SortOrder.LayoutOrder
    sbList.Padding             = UDim.new(0,BTN_G)
    sbList.Parent              = sbHolder
    pad(sbHolder,10,10,0,0)

    ----------------------------------------------------------------
    -- CONTENT AREA  — holds two side-by-side ScrollingFrames per tab
    ----------------------------------------------------------------
    local contentArea          = Instance.new("Frame")
    contentArea.Name           = "Content"
    contentArea.Size           = UDim2.new(1,-SB_W,1,-TOP_H-FOOT_H)
    contentArea.Position       = UDim2.new(0,SB_W,0,TOP_H)
    contentArea.BackgroundTransparency = 1
    contentArea.ClipsDescendants = true
    contentArea.ZIndex         = Z.Content
    contentArea.Parent         = main

    -- thin vertical divider between the two columns (always visible)
    local colDiv               = Instance.new("Frame")
    colDiv.Size                = UDim2.new(0,1,1,0)
    colDiv.Position            = UDim2.new(0.5,0,0,0)
    colDiv.BackgroundColor3    = T.Stroke
    colDiv.BorderSizePixel     = 0
    colDiv.ZIndex              = Z.Content+1
    colDiv.Parent              = contentArea

    ----------------------------------------------------------------
    -- FOOTER
    ----------------------------------------------------------------
    local footer               = Instance.new("Frame")
    footer.Name                = "Footer"
    footer.Size                = UDim2.new(1,0,0,FOOT_H)
    footer.Position            = UDim2.new(0,0,1,-FOOT_H)
    footer.BackgroundColor3    = T.Footer
    footer.BackgroundTransparency = 0.06
    footer.ZIndex              = Z.Footer
    footer.Parent              = main
    corner(footer, RADIUS)

    local footLine             = Instance.new("Frame")
    footLine.Size              = UDim2.new(1,0,0,1)
    footLine.BackgroundColor3  = T.Stroke
    footLine.BorderSizePixel   = 0
    footLine.ZIndex            = Z.Footer+1
    footLine.Parent            = footer

    local discLbl = lbl(footer, "Arena | https://"..DISCORD_LINK,
        10,T.TextDim,Enum.Font.Gotham,Enum.TextXAlignment.Center,Z.Footer+2)
    discLbl.Size = UDim2.new(1,0,1,0)
    task.spawn(function()
        local hue=0
        while gui.Parent do
            hue=(hue+1)%360
            discLbl.TextColor3=Color3.fromHSV(hue/360,0.7,1)
            task.wait(0.04)
        end
    end)

    ----------------------------------------------------------------
    -- DROPDOWN OVERLAY
    ----------------------------------------------------------------
    local dropOverlay          = Instance.new("Frame")
    dropOverlay.Size           = UDim2.new(1,0,1,0)
    dropOverlay.BackgroundTransparency = 1
    dropOverlay.ZIndex         = Z.Dropdown
    dropOverlay.Parent         = gui

    local activeDropClose = nil

    ----------------------------------------------------------------
    -- NOTIFICATIONS
    ----------------------------------------------------------------
    local notifHolder          = Instance.new("Frame")
    notifHolder.Size           = UDim2.new(0,300,1,0)
    notifHolder.AnchorPoint    = Vector2.new(0,1)
    notifHolder.Position       = UDim2.new(0,14,1,-14)
    notifHolder.BackgroundTransparency = 1
    notifHolder.ZIndex         = Z.Notif
    notifHolder.Parent         = gui

    local notifList            = Instance.new("UIListLayout")
    notifList.VerticalAlignment = Enum.VerticalAlignment.Bottom
    notifList.Padding          = UDim.new(0,8)
    notifList.SortOrder        = Enum.SortOrder.LayoutOrder
    notifList.Parent           = notifHolder

    ----------------------------------------------------------------
    -- TOOLTIP
    ----------------------------------------------------------------
    local tipOverlay           = Instance.new("Frame")
    tipOverlay.Size            = UDim2.new(1,0,1,0)
    tipOverlay.BackgroundTransparency = 1
    tipOverlay.ZIndex          = Z.Tooltip
    tipOverlay.Parent          = gui

    local sharedTip            = Instance.new("Frame")
    sharedTip.Size             = UDim2.new(0,10,0,22)
    sharedTip.BackgroundColor3 = T.Card
    sharedTip.BackgroundTransparency = 0.05
    sharedTip.Visible          = false
    sharedTip.ZIndex           = Z.Tooltip
    sharedTip.Parent           = tipOverlay
    corner(sharedTip,5); stroke(sharedTip,T.Accent,1)

    local tipLbl = lbl(sharedTip,"",11,T.Text,Enum.Font.GothamSemibold,Enum.TextXAlignment.Center,Z.Tooltip+1)
    tipLbl.Size = UDim2.new(1,0,1,0)
    pad(sharedTip,0,0,8,8)

    local function showTip(btn, label)
        tipLbl.Text = label
        local w = TextService:GetTextSize(label,11,Enum.Font.GothamSemibold,Vector2.new(400,22)).X+18
        sharedTip.Size = UDim2.new(0,w,0,22)
        task.defer(function()
            if not btn.Parent then return end
            local m = UserInputService:GetMouseLocation()
            sharedTip.Position = UDim2.new(0,main.AbsolutePosition.X+SB_W+6,0,m.Y-11)
            sharedTip.Visible = true
        end)
    end
    local function hideTip() sharedTip.Visible=false end

    ----------------------------------------------------------------
    -- SEARCH — filters rows in visible page columns
    ----------------------------------------------------------------
    local tabPageSets = {}  -- { [tabName] = {leftPage, rightPage} }

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = searchBox.Text:lower()
        for _, pages in pairs(tabPageSets) do
            for _, page in pairs(pages) do
                for _, child in ipairs(page:GetChildren()) do
                    local nl = child:FindFirstChild("NameLabel")
                    if nl then
                        child.Visible = q=="" or nl.Text:lower():find(q,1,true)
                    end
                end
            end
        end
    end)

    ----------------------------------------------------------------
    -- RESIZE / SHOW / HIDE
    ----------------------------------------------------------------
    local function computeSize()
        local vp  = workspace.CurrentCamera.ViewportSize
        local scl = math.min(1, math.min(vp.X/(WIN_W+24), vp.Y/(WIN_H+24))*0.94)
        return UDim2.new(0,math.round(WIN_W*scl),0,math.round(WIN_H*scl))
    end
    local function center(sz)
        main.Position = UDim2.new(0.5,-sz.X.Offset/2,0.5,-sz.Y.Offset/2)
    end

    local origSize = computeSize()
    main.Size = origSize; center(origSize)

    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        origSize = computeSize()
        main.Size = origSize; center(origSize)
    end)

    local isOpen = true
    local function setOpen(v)
        isOpen = v
        if v then
            main.Visible = true
            origSize = computeSize()
            main.Size = UDim2.new(0,math.round(origSize.X.Offset*0.9),0,math.round(origSize.Y.Offset*0.9))
            center(main.Size)
            tw(main,0.22,{Size=origSize},Enum.EasingStyle.Back)
        else
            tw(main,0.17,{Size=UDim2.new(0,math.round(origSize.X.Offset*0.85),0,math.round(origSize.Y.Offset*0.85))})
            task.delay(0.19,function() main.Visible=false end)
        end
    end

    closeBtn.MouseButton1Click:Connect(function() setOpen(false) end)
    UserInputService.InputBegan:Connect(function(i,gp)
        if gp then return end
        if i.KeyCode==Enum.KeyCode.RightShift then setOpen(not isOpen) end
    end)

    ----------------------------------------------------------------
    -- MINI LOGO
    ----------------------------------------------------------------
    local miniLogo             = Instance.new("ImageButton")
    miniLogo.Size              = UDim2.new(0,48,0,48)
    miniLogo.AnchorPoint       = Vector2.new(0,0.5)
    miniLogo.Position          = UDim2.new(0,8,0.5,0)
    miniLogo.BackgroundColor3  = T.AccentDim
    miniLogo.Image             = LOGO_ID
    miniLogo.ScaleType         = Enum.ScaleType.Fit
    miniLogo.AutoButtonColor   = false
    miniLogo.ZIndex            = Z.MiniLogo
    miniLogo.Visible           = miniLogoEnabled
    miniLogo.Parent            = gui
    corner(miniLogo,24); stroke(miniLogo,T.Accent,2)
    miniLogo.MouseEnter:Connect(function() tw(miniLogo,0.14,{BackgroundColor3=T.Accent}) end)
    miniLogo.MouseLeave:Connect(function() tw(miniLogo,0.14,{BackgroundColor3=T.AccentDim}) end)

    local mlDragOn,mlDragInp,mlDragStart,mlPosStart,mlMoved = false,nil,nil,nil,false
    miniLogo.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then
            mlDragOn=true; mlMoved=false; mlDragStart=i.Position; mlPosStart=miniLogo.Position
            i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then mlDragOn=false end end)
        end
    end)
    miniLogo.InputChanged:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseMovement then mlDragInp=i end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if i==mlDragInp and mlDragOn and mlDragStart then
            local d=i.Position-mlDragStart
            if d.Magnitude>4 then mlMoved=true end
            miniLogo.Position=UDim2.new(mlPosStart.X.Scale,mlPosStart.X.Offset+d.X,
                                         mlPosStart.Y.Scale,mlPosStart.Y.Offset+d.Y)
        end
    end)
    miniLogo.MouseButton1Click:Connect(function() if not mlMoved then setOpen(not isOpen) end end)

    ----------------------------------------------------------------
    -- SHARED SLIDER DRAG
    ----------------------------------------------------------------
    local activeDragFn,activeDragEnd = nil,nil
    UserInputService.InputChanged:Connect(function(i)
        if activeDragFn and i.UserInputType==Enum.UserInputType.MouseMovement then
            activeDragFn(i.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 and activeDragEnd then
            activeDragEnd(); activeDragFn=nil; activeDragEnd=nil
        end
    end)

