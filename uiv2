    ------------------------------------------------------------------
    -- SEARCH FILTER FUNCTION  (called on searchBox change)
    ------------------------------------------------------------------
    -- We'll wire this up per-tab by storing tab pages in a table
    local tabPages = {}   -- { [tabName] = page }

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local q = searchBox.Text:lower()
        for _, page in pairs(tabPages) do
            for _, child in pairs(page:GetChildren()) do
                -- Hide controls whose names don't match; always show sections
                if child:IsA("Frame") or child:IsA("TextButton") then
                    local nameLbl = child:FindFirstChild("NameLabel")
                    if nameLbl then
                        local match = q == "" or nameLbl.Text:lower():find(q, 1, true)
                        child.Visible = match and true or false
                    end
                end
            end
        end
    end)

    ------------------------------------------------------------------
    -- AUTO RESIZE
    ------------------------------------------------------------------
    local function computeMainSize()
        local vp  = workspace.CurrentCamera.ViewportSize
        local scl = math.min(1, math.min(vp.X / (WIN_W + 24), vp.Y / (WIN_H + 24)) * 0.94)
        return UDim2.new(0, math.round(WIN_W * scl), 0, math.round(WIN_H * scl))
    end

    local function centerMain(sz)
        main.Position = UDim2.new(0.5, -sz.X.Offset / 2, 0.5, -sz.Y.Offset / 2)
    end

    local origSize = computeMainSize()
    main.Size = origSize
    centerMain(origSize)

    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        origSize = computeMainSize()
        if isOpen then
            main.Size = origSize
            centerMain(origSize)
        end
    end)

    ------------------------------------------------------------------
    -- SHOW / HIDE
    ------------------------------------------------------------------
    local isOpen = true

    local function setOpen(val)
        isOpen = val
        if isOpen then
            main.Visible = true
            origSize = computeMainSize()
            main.Size = UDim2.new(0, math.round(origSize.X.Offset * 0.9),
                                   0, math.round(origSize.Y.Offset * 0.9))
            centerMain(main.Size)
            tw(main, 0.22, {Size = origSize}, Enum.EasingStyle.Back)
        else
            tw(main, 0.17, {Size = UDim2.new(0, math.round(origSize.X.Offset * 0.85),
                                              0, math.round(origSize.Y.Offset * 0.85))})
            task.delay(0.19, function() main.Visible = false end)
        end
    end

