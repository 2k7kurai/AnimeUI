    titleLbl.Size     = UDim2.new(0,190,1,0)
    titleLbl.Position = UDim2.new(0,44,0,0)

    -- Search bar (centred)
    local sfr              = Instance.new("Frame")
    sfr.Size               = UDim2.new(0,210,0,28)
    sfr.AnchorPoint        = Vector2.new(0.5,0.5)
    sfr.Position           = UDim2.new(0.5,0,0.5,0)
    sfr.BackgroundColor3   = T.Card
    sfr.ZIndex             = Z.Topbar+2
    sfr.Parent             = topbar
