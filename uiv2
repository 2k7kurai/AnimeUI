    ----------------------------------------------------------------
    -- CREATE TAB
    ----------------------------------------------------------------
    function Window:CreateTab(name, iconId)
        if not self._alive then return {} end
        Window._tabCount += 1
        local idx = Window._tabCount

        -- Sidebar button
        local tabBtn           = Instance.new("ImageButton")
        tabBtn.Name            = "TabBtn_"..name
        tabBtn.Size            = UDim2.new(0,BTN_SZ,0,BTN_SZ)
        tabBtn.BackgroundColor3 = T.Card
        tabBtn.Image           = iconId or ""
        tabBtn.ImageColor3     = Color3.new(1,1,1)
        tabBtn.ImageTransparency = 0.25
        tabBtn.ScaleType       = Enum.ScaleType.Fit
        tabBtn.AutoButtonColor = false
        tabBtn.LayoutOrder     = idx
        tabBtn.ZIndex          = Z.Sidebar+2
        tabBtn.Parent          = sbHolder
        corner(tabBtn,8)
        local tabS = stroke(tabBtn,T.Stroke,1.5)

        local activeBar        = Instance.new("Frame")
        activeBar.Size         = UDim2.new(0,3,0,18)
        activeBar.AnchorPoint  = Vector2.new(0,0.5)
        activeBar.Position     = UDim2.new(0,-8,0.5,0)
        activeBar.BackgroundColor3 = T.Accent
        activeBar.BorderSizePixel  = 0
        activeBar.Visible      = false
        activeBar.ZIndex       = Z.Sidebar+3
        activeBar.Parent       = tabBtn
        pillCorner(activeBar)

        --------------------------------------------------------------
        -- TWO INDEPENDENT SCROLL COLUMNS
        -- Left column  = 0 … 50%  of content area
        -- Right column = 50% … 100%
        --------------------------------------------------------------
        local HALF = 0.5   -- each column is exactly half width

        local function makeColumn(xScale)
            local sf = Instance.new("ScrollingFrame")
            sf.Size  = UDim2.new(HALF - 0.005, 0, 1, 0)
            sf.Position = UDim2.new(xScale + (xScale>0 and 0.005 or 0), 0, 0, 0)
            sf.BackgroundTransparency  = 1
            sf.ScrollBarThickness      = 3
            sf.ScrollBarImageColor3    = T.Accent
            sf.ScrollBarImageTransparency = 0.5
            sf.CanvasSize              = UDim2.new(0,0,0,0)
            sf.AutomaticCanvasSize     = Enum.AutomaticSize.Y
            sf.ClipsDescendants        = true
            sf.Visible                 = false
            sf.ZIndex                  = Z.Controls
            sf.Parent                  = contentArea
            pad(sf,10,10,8,8)

            local ll = Instance.new("UIListLayout")
            ll.FillDirection = Enum.FillDirection.Vertical
            ll.Padding       = UDim.new(0,4)
            ll.SortOrder     = Enum.SortOrder.LayoutOrder
            ll.Parent        = sf
            return sf
        end

        local leftPage  = makeColumn(0)
        local rightPage = makeColumn(HALF)

        tabPageSets[name] = {leftPage, rightPage}

        --------------------------------------------------------------
        -- ACTIVATE
        --------------------------------------------------------------
        local function activate()
            -- hide all pages
            for _, pages in pairs(tabPageSets) do
                for _, p in ipairs(pages) do p.Visible=false end
            end
            -- deselect all sidebar buttons
            for _, b in pairs(sbHolder:GetChildren()) do
                if b:IsA("ImageButton") then
                    tw(b,0.15,{BackgroundColor3=T.Card,ImageTransparency=0.25})
                    local s=b:FindFirstChildOfClass("UIStroke"); if s then tw(s,0.15,{Color=T.Stroke}) end
                    local ab=b:FindFirstChildOfClass("Frame"); if ab then ab.Visible=false end
                end
            end
            leftPage.Visible  = true
            rightPage.Visible = true
            tw(tabBtn,0.18,{BackgroundColor3=T.AccentDim,ImageTransparency=0})
            tw(tabS,0.18,{Color=T.Accent})
            activeBar.Visible = true
            Window._active = name
        end

        tabBtn.MouseButton1Click:Connect(activate)
        tabBtn.MouseEnter:Connect(function()
            showTip(tabBtn, name)
            if Window._active~=name then tw(tabBtn,0.11,{BackgroundColor3=T.CardHover,ImageTransparency=0.1}) end
        end)
        tabBtn.MouseLeave:Connect(function()
            hideTip()
            if Window._active~=name then tw(tabBtn,0.11,{BackgroundColor3=T.Card,ImageTransparency=0.25}) end
        end)

        if idx==1 then task.defer(activate) end

        --------------------------------------------------------------
        -- TAB API
        --------------------------------------------------------------
        local Tab    = {}
        local leftOrd  = 0
        local rightOrd = 0

        local function getPage(col)
            if col=="Right" then return rightPage else return leftPage end
        end
        local function nextOrd(col)
            if col=="Right" then rightOrd+=1; return rightOrd
            else leftOrd+=1; return leftOrd end
        end

        -- ── ROW FACTORY ──────────────────────────────────────────
        -- Every control is a compact row: fixed height, full width of column.
        -- Cerberus rows are ~32px tall, sections are ~20px headers.
        local ROW_H = 32
        local SEC_H = 26

        local function makeRow(col, h)
            local page = getPage(col)
            local row  = Instance.new("Frame")
            row.Size   = UDim2.new(1,0,0,h or ROW_H)
            row.BackgroundColor3 = T.Card
            row.LayoutOrder      = nextOrd(col)
            row.ZIndex           = Z.Controls
            row.Parent           = page
            corner(row, 6)
            return row
        end

        -- ── SECTION ──────────────────────────────────────────────
        function Tab:AddSection(title, col)
            col = col or "Left"
            local page = getPage(col)

            local f    = Instance.new("Frame")
            f.Size     = UDim2.new(1,0,0,SEC_H)
            f.BackgroundTransparency = 1
            f.LayoutOrder = nextOrd(col)
            f.ZIndex   = Z.Controls
            f.Parent   = page

            -- horizontal rule
            local rule = Instance.new("Frame")
            rule.Size  = UDim2.new(1,0,0,1)
            rule.Position = UDim2.new(0,0,0.6,0)
            rule.BackgroundColor3 = T.Stroke
            rule.BorderSizePixel  = 0
            rule.ZIndex           = Z.Controls
            rule.Parent           = f

            -- section title pill
            local pill = Instance.new("Frame")
            pill.Size  = UDim2.new(0,0,0,16)
            pill.AutomaticSize = Enum.AutomaticSize.X
            pill.BackgroundColor3 = T.BG
            pill.BorderSizePixel  = 0
            pill.ZIndex           = Z.Controls+1
            pill.Parent           = f
            pad(pill,0,0,0,6)

            local sl = lbl(pill,(title or ""):upper(),9,T.SecHead,Enum.Font.GothamBold,Enum.TextXAlignment.Left,Z.Controls+2)
            sl.Size          = UDim2.new(0,0,1,0)
            sl.AutomaticSize = Enum.AutomaticSize.X
        end

        -- ── TOGGLE ───────────────────────────────────────────────
        function Tab:AddToggle(c2)
            c2 = c2 or {}
            local col   = c2.Col or "Left"
            local state = c2.Default or false
            local row   = makeRow(col, ROW_H)

            -- name label
            local nm = lbl(row, c2.Name or "Toggle", 12, T.Text,
                Enum.Font.GothamSemibold, Enum.TextXAlignment.Left, Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(1,-52,1,0)
            nm.Position = UDim2.new(0,10,0,0)

            -- compact toggle track
            local track = Instance.new("Frame")
            track.Size  = UDim2.new(0,34,0,18)
            track.Position = UDim2.new(1,-44,0.5,-9)
            track.BackgroundColor3 = state and T.Accent or T.CardHover
            track.ZIndex = Z.Controls+1
            track.Parent = row
            corner(track,9)

            local knob = Instance.new("Frame")
            knob.Size  = UDim2.new(0,14,0,14)
            knob.Position = state and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)
            knob.BackgroundColor3 = Color3.new(1,1,1)
            knob.ZIndex = Z.Controls+2
            knob.Parent = track
            corner(knob,7)

            local rS = row:FindFirstChildOfClass("UIStroke")

            local function refresh()
                tw(track,0.18,{BackgroundColor3=state and T.Accent or T.CardHover})
                tw(knob,0.18,{Position=state and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7)})
                if rS then tw(rS,0.18,{Color=state and T.Accent or T.Stroke}) end
            end

            local btn = Instance.new("TextButton")
            btn.Size  = UDim2.new(1,0,1,0); btn.BackgroundTransparency=1
            btn.Text  = ""; btn.ZIndex=Z.Controls+3; btn.Parent=row

            btn.MouseButton1Click:Connect(function()
                if not Window._alive then return end
                state=not state; refresh()
                Window:Notify({Title=(c2.Name or "Toggle")..(state and " On" or " Off"),
                    Type=state and "success" or "default",Duration=2})
                if c2.Callback then c2.Callback(state) end
            end)
            btn.MouseEnter:Connect(function() tw(row,0.1,{BackgroundColor3=T.CardHover}) end)
            btn.MouseLeave:Connect(function() tw(row,0.1,{BackgroundColor3=T.Card}) end)
            refresh()

            local Tog={}
            function Tog:Set(v) state=v; refresh(); if c2.Callback then c2.Callback(state) end end
            function Tog:Get() return state end
            if c2.Flag then Window.Flags[c2.Flag]={Type="Toggle",Set=Tog.Set,Get=Tog.Get} end
            return Tog
        end

        -- ── BUTTON ───────────────────────────────────────────────
        function Tab:AddButton(c2)
            c2  = c2 or {}
            local col = c2.Col or "Left"
            local row = makeRow(col, ROW_H)

            local nm = lbl(row, c2.Name or "Button", 12, T.Text,
                Enum.Font.GothamSemibold, Enum.TextXAlignment.Left, Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(1,-28,1,0)
            nm.Position = UDim2.new(0,10,0,0)

            local arr = lbl(row,">",11,T.TextMuted,Enum.Font.GothamBold,Enum.TextXAlignment.Right,Z.Controls+1)
            arr.Size     = UDim2.new(0,18,1,0)
            arr.Position = UDim2.new(1,-22,0,0)

            local rS = row:FindFirstChildOfClass("UIStroke")
            local btn = Instance.new("TextButton")
            btn.Size=UDim2.new(1,0,1,0); btn.BackgroundTransparency=1
            btn.Text=""; btn.ZIndex=Z.Controls+3; btn.Parent=row

            btn.MouseEnter:Connect(function()
                tw(row,0.1,{BackgroundColor3=T.CardHover})
                if rS then tw(rS,0.1,{Color=T.Accent}) end
                tw(arr,0.1,{TextColor3=T.Accent})
            end)
            btn.MouseLeave:Connect(function()
                tw(row,0.1,{BackgroundColor3=T.Card})
                if rS then tw(rS,0.1,{Color=T.Stroke}) end
                tw(arr,0.1,{TextColor3=T.TextMuted})
            end)
            btn.MouseButton1Click:Connect(function()
                if not Window._alive then return end
                tw(row,0.05,{BackgroundColor3=T.AccentDim})
                task.delay(0.1,function() tw(row,0.12,{BackgroundColor3=T.CardHover}) end)
                if c2.Callback then c2.Callback() end
            end)
        end

        -- ── SLIDER ───────────────────────────────────────────────
        function Tab:AddSlider(c2)
            c2    = c2 or {}
            local col  = c2.Col or "Left"
            local minV = c2.Min or 0
            local maxV = c2.Max or 100
            local suf  = c2.Suffix or ""
            local value= math.clamp(c2.Default or minV, minV, maxV)
            local row  = makeRow(col, 48)

            local nm = lbl(row,c2.Name or "Slider",12,T.Text,Enum.Font.GothamSemibold,Enum.TextXAlignment.Left,Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(1,-50,0,16)
            nm.Position = UDim2.new(0,10,0,4)

            local vLbl = lbl(row,tostring(value)..suf,11,T.Accent,Enum.Font.GothamBold,Enum.TextXAlignment.Right,Z.Controls+1)
            vLbl.Size     = UDim2.new(0,40,0,16)
            vLbl.Position = UDim2.new(1,-48,0,4)

            local track = Instance.new("Frame")
            track.Size  = UDim2.new(1,-20,0,4)
            track.Position = UDim2.new(0,10,0,30)
            track.BackgroundColor3 = T.CardHover
            track.ZIndex = Z.Controls+1; track.Parent=row
            pillCorner(track)

            local fill = Instance.new("Frame")
            fill.Size  = UDim2.new((value-minV)/(maxV-minV),0,1,0)
            fill.BackgroundColor3 = T.Accent
            fill.ZIndex = Z.Controls+2; fill.Parent=track
            pillCorner(fill)

            local fg = Instance.new("UIGradient")
            fg.Color  = ColorSequence.new(T.AccentDim,T.AccentGlow); fg.Parent=fill

            local thumb = Instance.new("Frame")
            thumb.Size  = UDim2.new(0,10,0,10)
            thumb.AnchorPoint = Vector2.new(0.5,0.5)
            thumb.Position    = UDim2.new((value-minV)/(maxV-minV),0,0.5,0)
            thumb.BackgroundColor3 = Color3.new(1,1,1)
            thumb.ZIndex = Z.Controls+3; thumb.Parent=track
            corner(thumb,5)
            local tS = stroke(thumb,T.Accent,2)

            local function setV(x)
                local p=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
                value=math.floor(minV+p*(maxV-minV)+0.5)
                local pn=(value-minV)/(maxV-minV)
                tw(fill,0.04,{Size=UDim2.new(pn,0,1,0)}); tw(thumb,0.04,{Position=UDim2.new(pn,0,0.5,0)})
                vLbl.Text=tostring(value)..suf
                if c2.Callback then c2.Callback(value) end
            end

            track.InputBegan:Connect(function(i)
                if i.UserInputType==Enum.UserInputType.MouseButton1 then
                    tw(tS,0.1,{Color=T.AccentGlow}); setV(i.Position.X)
                    activeDragFn=function(x) setV(x) end
                    activeDragEnd=function()
                        tw(tS,0.1,{Color=T.Accent})
                        Window:Notify({Title=c2.Name or "Slider",Content="Set to "..tostring(value)..suf,Duration=2})
                    end
                end
            end)

            local Sl={}
            function Sl:Set(v)
                value=math.clamp(v,minV,maxV); local pn=(value-minV)/(maxV-minV)
                tw(fill,0.12,{Size=UDim2.new(pn,0,1,0)}); tw(thumb,0.12,{Position=UDim2.new(pn,0,0.5,0)})
                vLbl.Text=tostring(value)..suf; if c2.Callback then c2.Callback(value) end
            end
            function Sl:Get() return value end
            if c2.Flag then Window.Flags[c2.Flag]={Type="Slider",Set=Sl.Set,Get=Sl.Get} end
            return Sl
        end

        -- ── DROPDOWN ─────────────────────────────────────────────
        function Tab:AddDropdown(c2)
            c2   = c2 or {}
            local col  = c2.Col or "Left"
            local opts = c2.Options or {}
            local sel  = c2.Default or (opts[1] or "None")
            local open2= false
            local row  = makeRow(col, ROW_H)
            local rS   = row:FindFirstChildOfClass("UIStroke")

            local nm = lbl(row,c2.Name or "Dropdown",12,T.Text,Enum.Font.GothamSemibold,Enum.TextXAlignment.Left,Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(0.44,0,1,0)
            nm.Position = UDim2.new(0,10,0,0)

            local selB = Instance.new("TextButton")
            selB.Size  = UDim2.new(0.5,-4,0,22)
            selB.Position = UDim2.new(0.48,0,0.5,-11)
            selB.BackgroundColor3 = T.CardHover
            selB.Text  = sel
            selB.TextColor3 = T.Accent
            selB.Font  = Enum.Font.GothamSemibold
            selB.TextSize = 11
            selB.AutoButtonColor = false
            selB.ZIndex = Z.Controls+1; selB.Parent=row
            corner(selB,5); pad(selB,0,0,6,16)

            local chev = lbl(selB,"▾",10,T.TextMuted,Enum.Font.GothamBold,Enum.TextXAlignment.Right,Z.Controls+2)
            chev.Size = UDim2.new(1,-2,1,0)

            -- panel on overlay
            local dp = Instance.new("ScrollingFrame")
            dp.Size  = UDim2.new(0,0,0,0)
            dp.BackgroundColor3 = T.Panel
            dp.ClipsDescendants = true; dp.Active=true
            dp.ZIndex = Z.Dropdown; dp.Visible=false
            dp.ScrollBarThickness=3; dp.ScrollBarImageColor3=T.Accent
            dp.ScrollBarImageTransparency=0.4
            dp.CanvasSize=UDim2.new(0,0,0,0)
            dp.AutomaticCanvasSize=Enum.AutomaticSize.Y
            dp.ScrollingDirection=Enum.ScrollingDirection.Y
            dp.Parent=dropOverlay
            corner(dp,6); stroke(dp,T.Accent,1); pad(dp,3,3,3,3)

            local dpL=Instance.new("UIListLayout")
            dpL.Padding=UDim.new(0,2); dpL.SortOrder=Enum.SortOrder.LayoutOrder; dpL.Parent=dp

            local function closeD()
                if not open2 then return end
                open2=false; if activeDropClose==closeD then activeDropClose=nil end
                tw(dp,0.12,{Size=UDim2.new(0,dp.AbsoluteSize.X,0,0)})
                task.delay(0.13,function() dp.Visible=false end)
                tw(chev,0.12,{Rotation=0})
                if rS then tw(rS,0.12,{Color=T.Stroke}) end
            end

            local function buildOpts()
                for _,ch in pairs(dp:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
                for i,opt in ipairs(opts) do
                    local ob=Instance.new("TextButton")
                    ob.Size=UDim2.new(1,0,0,22); ob.BackgroundColor3=T.Card
                    ob.Text=opt; ob.TextColor3=opt==sel and T.Accent or T.Text
                    ob.Font=Enum.Font.Gotham; ob.TextSize=11
                    ob.AutoButtonColor=false; ob.LayoutOrder=i; ob.ZIndex=Z.Dropdown+1; ob.Parent=dp
                    corner(ob,4)
                    ob.MouseEnter:Connect(function() tw(ob,0.08,{BackgroundColor3=T.CardHover,TextColor3=T.AccentGlow}) end)
                    ob.MouseLeave:Connect(function() tw(ob,0.08,{BackgroundColor3=T.Card,TextColor3=opt==sel and T.Accent or T.Text}) end)
                    ob.MouseButton1Click:Connect(function()
                        if not Window._alive then return end
                        sel=opt; selB.Text=opt; closeD(); buildOpts()
                        Window:Notify({Title=c2.Name or "Dropdown",Content="Selected: "..opt,Duration=2})
                        if c2.Callback then c2.Callback(opt) end
                    end)
                end
            end
            buildOpts()

            selB.MouseButton1Click:Connect(function()
                if not Window._alive then return end
                if open2 then closeD(); return end
                if activeDropClose and activeDropClose~=closeD then activeDropClose() end
                open2=true; activeDropClose=closeD
                local ap=selB.AbsolutePosition; local as=selB.AbsoluteSize
                local pw=as.X+4; local ph=math.min(#opts*26+8,160)
                local sh=workspace.CurrentCamera.ViewportSize.Y
                local up=(sh-(ap.Y+as.Y))<ph+10
                dp.Size=UDim2.new(0,pw,0,0); dp.CanvasPosition=Vector2.zero
                dp.Position=up and UDim2.new(0,ap.X,0,ap.Y-ph-4) or UDim2.new(0,ap.X,0,ap.Y+as.Y+4)
                dp.Visible=true
                tw(dp,0.15,{Size=UDim2.new(0,pw,0,ph)})
                tw(chev,0.15,{Rotation=180})
                if rS then tw(rS,0.15,{Color=T.Accent}) end
            end)

            local DD={}
            function DD:Set(v) sel=v; selB.Text=v; buildOpts() end
            function DD:Get() return sel end
            function DD:SetOptions(o) opts=o; buildOpts() end
            if c2.Flag then Window.Flags[c2.Flag]={Type="Dropdown",Set=DD.Set,Get=DD.Get} end
            return DD
        end

        -- ── INPUT ────────────────────────────────────────────────
        function Tab:AddInput(c2)
            c2  = c2 or {}
            local col = c2.Col or "Left"
            local row = makeRow(col, 46)
            local rS  = row:FindFirstChildOfClass("UIStroke")

            local nm = lbl(row,c2.Name or "Input",12,T.Text,Enum.Font.GothamSemibold,Enum.TextXAlignment.Left,Z.Controls+1)
            nm.Name="NameLabel"; nm.Size=UDim2.new(1,-16,0,14); nm.Position=UDim2.new(0,10,0,4)

            local field=Instance.new("TextBox")
            field.Size=UDim2.new(1,-20,0,18); field.Position=UDim2.new(0,10,0,22)
            field.BackgroundColor3=T.CardHover; field.Text=c2.Default or ""
            field.PlaceholderText=c2.Placeholder or "Enter value..."
            field.PlaceholderColor3=T.TextMuted; field.TextColor3=T.Text
            field.Font=Enum.Font.Gotham; field.TextSize=11
            field.ClearTextOnFocus=c2.ClearOnFocus or false
            field.ZIndex=Z.Controls+1; field.Parent=row
            corner(field,5); pad(field,0,0,5,5)

            field.Focused:Connect(function()  if rS then tw(rS,0.12,{Color=T.Accent}) end end)
            field.FocusLost:Connect(function(e)
                if rS then tw(rS,0.12,{Color=T.Stroke}) end
                if c2.Callback then c2.Callback(field.Text,e) end
            end)

            local Inp={}
            function Inp:Get() return field.Text end
            function Inp:Set(v) field.Text=v end
            if c2.Flag then Window.Flags[c2.Flag]={Type="Input",Set=Inp.Set,Get=Inp.Get} end
            return Inp
        end

        -- ── LABEL ────────────────────────────────────────────────
        function Tab:AddLabel(text, col)
            local row=makeRow(col or "Left", 28)
            local l=lbl(row,text or "",11,T.TextDim,Enum.Font.Gotham,Enum.TextXAlignment.Left,Z.Controls)
            l.Name="NameLabel"; l.Size=UDim2.new(1,-16,1,0); l.Position=UDim2.new(0,10,0,0); l.TextWrapped=true
            local Lbl={}; function Lbl:Set(t) l.Text=t end; return Lbl
        end

        -- ── KEYBIND ──────────────────────────────────────────────
        function Tab:AddKeybind(c2)
            c2   = c2 or {}
            local col  = c2.Col or "Left"
            local bind = c2.Default or Enum.KeyCode.Unknown
            local lstn = false
            local row  = makeRow(col, ROW_H)

            local nm=lbl(row,c2.Name or "Keybind",12,T.Text,Enum.Font.GothamSemibold,Enum.TextXAlignment.Left,Z.Controls+1)
            nm.Name="NameLabel"; nm.Size=UDim2.new(1,-76,1,0); nm.Position=UDim2.new(0,10,0,0)

            local kb=Instance.new("TextButton")
            kb.Size=UDim2.new(0,56,0,20); kb.Position=UDim2.new(1,-62,0.5,-10)
            kb.BackgroundColor3=T.CardHover; kb.Text=bind.Name
            kb.TextColor3=T.Accent; kb.Font=Enum.Font.GothamBold; kb.TextSize=10
            kb.AutoButtonColor=false; kb.ZIndex=Z.Controls+1; kb.Parent=row
            corner(kb,5)

            kb.MouseButton1Click:Connect(function() lstn=true; kb.Text="..."; kb.TextColor3=T.Warning end)

            Window:_Connect(UserInputService.InputBegan,function(i,gp)
                if not lstn then return end
                if i.UserInputType==Enum.UserInputType.Keyboard then
                    lstn=false; bind=i.KeyCode; kb.Text=bind.Name; kb.TextColor3=T.Accent
                    if not Window._alive then return end
                    Window:Notify({Title=c2.Name or "Keybind",Content="Bound to "..bind.Name,Duration=2})
                    if c2.Callback then c2.Callback(bind) end
                end
            end)

            local KB={}
            function KB:Get() return bind end
            function KB:Set(k) bind=k; kb.Text=k.Name end
            if c2.Flag then Window.Flags[c2.Flag]={Type="Keybind",Set=KB.Set,Get=KB.Get} end
            return KB
        end

        return Tab
    end  -- CreateTab

    return Window
end  -- CreateWindow

return ZenithImmortal
