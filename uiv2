    local sfS = stroke(sfr, T.Stroke, 1)

    local sIcon = lbl(sfr,"⌕",14,T.TextMuted,Enum.Font.Gotham,Enum.TextXAlignment.Left,Z.Topbar+3)
    sIcon.Size     = UDim2.new(0,22,1,0)
    sIcon.Position = UDim2.new(0,5,0,0)

    local searchBox            = Instance.new("TextBox")
