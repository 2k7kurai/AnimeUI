    ------------------------------------------------------------------
    -- CREATE TAB  (Cerberus two-column layout)
    ------------------------------------------------------------------
    function Window:CreateTab(name, iconId)
        if not self._alive then return {} end
        Window._tabCount += 1
        local idx = Window._tabCount

        -- Sidebar icon button
        local tabBtn                   = Instance.new("ImageButton")
        tabBtn.Name                    = "TabBtn_" .. name
        tabBtn.Size                    = UDim2.new(0, BTN_SZ, 0, BTN_SZ)
        tabBtn.BackgroundColor3        = T.Card
        tabBtn.Image                   = iconId or ""
        tabBtn.ImageColor3             = Color3.new(1, 1, 1)
        tabBtn.ImageTransparency       = 0.25
        tabBtn.ScaleType               = Enum.ScaleType.Fit
        tabBtn.AutoButtonColor         = false
        tabBtn.LayoutOrder             = idx
        tabBtn.ZIndex                  = Z.Sidebar + 2
        tabBtn.Parent                  = sbHolder
        corner(tabBtn, 8)
        local tabS = stroke(tabBtn, T.Stroke, 1.5)

        -- Active indicator (left accent bar)
        local activeBar                = Instance.new("Frame")
        activeBar.Size                 = UDim2.new(0, 3, 0, 20)
        activeBar.AnchorPoint          = Vector2.new(0, 0.5)
        activeBar.Position             = UDim2.new(0, -8, 0.5, 0)
        activeBar.BackgroundColor3     = T.Accent
        activeBar.BorderSizePixel      = 0
        activeBar.Visible              = false
        activeBar.ZIndex               = Z.Sidebar + 3
        activeBar.Parent               = tabBtn
        pillCorner(activeBar)

        -----------------------------------------------------------
        -- TWO-COLUMN SCROLLING PAGE
        -----------------------------------------------------------
        local page                         = Instance.new("ScrollingFrame")
        page.Name                          = "Page_" .. name
        page.Size                          = UDim2.new(1, 0, 1, 0)
        page.BackgroundTransparency        = 1
        page.Visible                       = false
        page.ScrollBarThickness            = 3
        page.ScrollBarImageColor3          = T.Accent
        page.ScrollBarImageTransparency    = 0.5
        page.CanvasSize                    = UDim2.new(0, 0, 0, 0)
        page.AutomaticCanvasSize           = Enum.AutomaticSize.Y
        page.ClipsDescendants              = true
        page.ZIndex                        = Z.Controls
        page.Parent                        = contentArea
        pad(page, 10, 10, 10, 10)

        -- Two-column grid container
        local gridFrame                    = Instance.new("Frame")
        gridFrame.Size                     = UDim2.new(1, 0, 0, 0)
        gridFrame.AutomaticSize            = Enum.AutomaticSize.Y
        gridFrame.BackgroundTransparency   = 1
        gridFrame.ZIndex                   = Z.Controls
        gridFrame.Parent                   = page

        local grid                         = Instance.new("UIGridLayout")
        grid.CellSize                      = UDim2.new(0.5, -6, 0, 0)  -- auto height per cell
        grid.CellPadding                   = UDim2.new(0, 8, 0, 8)
        grid.SortOrder                     = Enum.SortOrder.LayoutOrder
        grid.FillDirection                 = Enum.FillDirection.Horizontal
        grid.HorizontalAlignment           = Enum.HorizontalAlignment.Left
        grid.VerticalAlignment             = Enum.VerticalAlignment.Top
        grid.Parent                        = gridFrame

        -- Section headers span full width — we inject them into a
        -- separate vertical list above the grid so they break columns.
        -- We use a UIListLayout on the page itself for sections,
        -- and card groups go into gridFrame children.
        -- Simplest approach: alternate between full-width section frames
        -- and column-pair frames. We manage this with a listlayout on page.

        -- Actually: Roblox UIGridLayout can't mix full-width rows.
        -- Solution: We embed full-width "section header" frames OUTSIDE
        -- the grid, using a UIListLayout on the page directly.
        -- The grid is a CHILD of the page alongside section frames.
        -- We re-create a column frame per section for clean grouping.
        gridFrame:Destroy()  -- remove placeholder

        local pageList                     = Instance.new("UIListLayout")
        pageList.FillDirection             = Enum.FillDirection.Vertical
        pageList.Padding                   = UDim.new(0, 6)
        pageList.SortOrder                 = Enum.SortOrder.LayoutOrder
        pageList.Parent                    = page

        tabPages[name] = page

        -----------------------------------------------------------
        -- ACTIVATE
        -----------------------------------------------------------
        local function activate()
            for _, p in pairs(contentArea:GetChildren()) do
                if p:IsA("ScrollingFrame") then p.Visible = false end
            end
            for _, b in pairs(sbHolder:GetChildren()) do
                if b:IsA("ImageButton") then
                    tw(b, 0.17, {BackgroundColor3 = T.Card, ImageTransparency = 0.25})
                    local s = b:FindFirstChildOfClass("UIStroke")
                    if s then tw(s, 0.17, {Color = T.Stroke}) end
                    local ab = b:FindFirstChild("ActiveBar") or b:FindFirstChildOfClass("Frame")
                    if ab then ab.Visible = false end
                end
            end
            page.Visible = true
            tw(tabBtn, 0.2, {BackgroundColor3 = T.AccentDim, ImageTransparency = 0})
            tw(tabS,   0.2, {Color = T.Accent})
            activeBar.Visible = true
            Window._active = name
        end

        tabBtn.MouseButton1Click:Connect(activate)
        tabBtn.MouseEnter:Connect(function()
            showTip(tabBtn, name)
            if Window._active ~= name then
                tw(tabBtn, 0.12, {BackgroundColor3 = T.CardHover, ImageTransparency = 0.1})
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            hideTip()
            if Window._active ~= name then
                tw(tabBtn, 0.12, {BackgroundColor3 = T.Card, ImageTransparency = 0.25})
            end
        end)

        if idx == 1 then task.defer(activate) end

        -----------------------------------------------------------
        -- TAB API
        -----------------------------------------------------------
        local Tab   = {}
        local order = 0
        local function nxt() order += 1; return order end

        -- Current column-pair grid — created fresh per section
        local currentGrid = nil
        local currentGridOrder = 0

        local function ensureGrid()
            if not currentGrid then
                currentGridOrder = nxt()
                local gf = Instance.new("Frame")
                gf.Size             = UDim2.new(1, 0, 0, 0)
                gf.AutomaticSize    = Enum.AutomaticSize.Y
                gf.BackgroundTransparency = 1
                gf.LayoutOrder      = currentGridOrder
                gf.ZIndex           = Z.Controls
                gf.Parent           = page

                local gl = Instance.new("UIGridLayout")
                gl.CellSize         = UDim2.new(0.5, -5, 0, 44)
                gl.CellPadding      = UDim2.new(0, 8, 0, 6)
                gl.SortOrder        = Enum.SortOrder.LayoutOrder
                gl.FillDirection    = Enum.FillDirection.Horizontal
                gl.Parent           = gf

                currentGrid = gf
            end
            return currentGrid
        end

        local function newCard(h)
            local gf = ensureGrid()
            -- update cell height dynamically
            local gl = gf:FindFirstChildOfClass("UIGridLayout")
            if gl then gl.CellSize = UDim2.new(0.5, -5, 0, h or 44) end

            local card                 = Instance.new("Frame")
            card.BackgroundColor3      = T.Card
            card.BackgroundTransparency = 0
            card.ZIndex                = Z.Controls
            card.LayoutOrder           = nxt()
            card.Parent                = gf
            corner(card, 10)
            stroke(card, T.Stroke, 1)
            return card
        end

        ---- SECTION (full-width header — resets the column grid) ----
        function Tab:AddSection(title)
            currentGrid = nil  -- force new grid after section

            local f                    = Instance.new("Frame")
            f.Name                     = "Section_" .. (title or "")
            f.Size                     = UDim2.new(1, 0, 0, 24)
            f.BackgroundTransparency   = 1
            f.LayoutOrder              = nxt()
            f.ZIndex                   = Z.Controls
            f.Parent                   = page

            local line                 = Instance.new("Frame")
            line.Size                  = UDim2.new(1, 0, 0, 1)
            line.Position              = UDim2.new(0, 0, 0.5, 3)
            line.BackgroundColor3      = T.Stroke
            line.BorderSizePixel       = 0
            line.ZIndex                = Z.Controls
            line.Parent                = f

            local pill                 = Instance.new("Frame")
            pill.Size                  = UDim2.new(0, 0, 0, 18)
            pill.AutomaticSize         = Enum.AutomaticSize.X
            pill.Position              = UDim2.new(0, 0, 0, 3)
            pill.BackgroundColor3      = T.BG
            pill.BorderSizePixel       = 0
            pill.ZIndex                = Z.Controls + 1
            pill.Parent                = f
            pad(pill, 0, 0, 0, 8)

            local sLbl = lbl(pill, (title or ""):upper(),
                9, T.Accent, Enum.Font.GothamBold, Enum.TextXAlignment.Left, Z.Controls+2)
            sLbl.Size          = UDim2.new(0, 0, 1, 0)
            sLbl.AutomaticSize = Enum.AutomaticSize.X
        end

        ---- TOGGLE ----
        function Tab:AddToggle(c2)
            c2 = c2 or {}
            local state = c2.Default or false

            local card = newCard(44)

            local nm = lbl(card, c2.Name or "Toggle", 12,
                T.Text, Enum.Font.GothamSemibold, Enum.TextXAlignment.Left, Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(1, -54, 1, 0)
            nm.Position = UDim2.new(0, 10, 0, 0)

            local track                = Instance.new("Frame")
            track.Size                 = UDim2.new(0, 36, 0, 18)
            track.Position             = UDim2.new(1, -46, 0.5, -9)
            track.BackgroundColor3     = state and T.Accent or T.CardHover
            track.ZIndex               = Z.Controls + 1
            track.Parent               = card
            corner(track, 9)

            local knob                 = Instance.new("Frame")
            knob.Size                  = UDim2.new(0, 14, 0, 14)
            knob.Position              = state
                and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
            knob.BackgroundColor3      = Color3.new(1, 1, 1)
            knob.ZIndex                = Z.Controls + 2
            knob.Parent                = track
            corner(knob, 7)

            local cS = card:FindFirstChildOfClass("UIStroke")

            local function refresh()
                tw(track, 0.2, {BackgroundColor3 = state and T.Accent or T.CardHover})
                tw(knob,  0.2, {Position = state
                    and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)})
                if cS then tw(cS, 0.2, {Color = state and T.Accent or T.Stroke}) end
            end

            local btn = Instance.new("TextButton")
            btn.Size  = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1
            btn.Text  = ""; btn.ZIndex = Z.Controls + 3; btn.Parent = card

            btn.MouseButton1Click:Connect(function()
                if not Window._alive then return end
                state = not state; refresh()
                Window:Notify({ Title=(c2.Name or "Toggle")..(state and " On" or " Off"),
                    Type=state and "success" or "default", Duration=2 })
                if c2.Callback then c2.Callback(state) end
            end)
            btn.MouseEnter:Connect(function() tw(card, 0.12, {BackgroundColor3 = T.CardHover}) end)
            btn.MouseLeave:Connect(function() tw(card, 0.12, {BackgroundColor3 = T.Card}) end)
            refresh()

            local Tog = {}
            function Tog:Set(v) state=v; refresh(); if c2.Callback then c2.Callback(state) end end
            function Tog:Get() return state end
            if c2.Flag then Window.Flags[c2.Flag] = { Type="Toggle", Set=Tog.Set, Get=Tog.Get } end
            return Tog
        end

        ---- BUTTON ----
        function Tab:AddButton(c2)
            c2 = c2 or {}
            local card = newCard(44)

            local nm = lbl(card, c2.Name or "Button", 12,
                T.Text, Enum.Font.GothamSemibold, Enum.TextXAlignment.Left, Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(1, -34, 1, 0)
            nm.Position = UDim2.new(0, 10, 0, 0)

            local arr = lbl(card, ">", 11, T.TextMuted,
                Enum.Font.GothamBold, Enum.TextXAlignment.Right, Z.Controls+1)
            arr.Size     = UDim2.new(0, 20, 1, 0)
            arr.Position = UDim2.new(1, -24, 0, 0)

            local cS = card:FindFirstChildOfClass("UIStroke")

            local btn = Instance.new("TextButton")
            btn.Size  = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1
            btn.Text  = ""; btn.ZIndex = Z.Controls + 3; btn.Parent = card

            btn.MouseEnter:Connect(function()
                tw(card, 0.12, {BackgroundColor3 = T.CardHover})
                if cS then tw(cS, 0.12, {Color = T.Accent}) end
                tw(arr, 0.12, {TextColor3 = T.Accent})
            end)
            btn.MouseLeave:Connect(function()
                tw(card, 0.12, {BackgroundColor3 = T.Card})
                if cS then tw(cS, 0.12, {Color = T.Stroke}) end
                tw(arr, 0.12, {TextColor3 = T.TextMuted})
            end)
            btn.MouseButton1Click:Connect(function()
                if not Window._alive then return end
                tw(card, 0.06, {BackgroundColor3 = T.AccentDim})
                task.delay(0.06, function() tw(card, 0.14, {BackgroundColor3 = T.CardHover}) end)
                if c2.Callback then c2.Callback() end
            end)
        end

        ---- SLIDER ----
        function Tab:AddSlider(c2)
            c2    = c2 or {}
            local minV  = c2.Min    or 0
            local maxV  = c2.Max    or 100
            local suf   = c2.Suffix or ""
            local value = math.clamp(c2.Default or minV, minV, maxV)

            local card = newCard(54)
            local cS   = card:FindFirstChildOfClass("UIStroke")

            local nm = lbl(card, c2.Name or "Slider", 12,
                T.Text, Enum.Font.GothamSemibold, Enum.TextXAlignment.Left, Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(1, -52, 0, 18)
            nm.Position = UDim2.new(0, 10, 0, 6)

            local vLbl = lbl(card, tostring(value)..suf, 11,
                T.Accent, Enum.Font.GothamBold, Enum.TextXAlignment.Right, Z.Controls+1)
            vLbl.Size     = UDim2.new(0, 40, 0, 18)
            vLbl.Position = UDim2.new(1, -48, 0, 6)

            local track                = Instance.new("Frame")
            track.Size                 = UDim2.new(1, -20, 0, 5)
            track.Position             = UDim2.new(0, 10, 0, 36)
            track.BackgroundColor3     = T.CardHover
            track.ZIndex               = Z.Controls + 1
            track.Parent               = card
            pillCorner(track)

            local fill                 = Instance.new("Frame")
            fill.Size                  = UDim2.new((value-minV)/(maxV-minV), 0, 1, 0)
            fill.BackgroundColor3      = T.Accent
            fill.ZIndex                = Z.Controls + 2
            fill.Parent                = track
            pillCorner(fill)

            local fg       = Instance.new("UIGradient")
            fg.Color       = ColorSequence.new(T.AccentDim, T.AccentGlow)
            fg.Parent      = fill

            local thumb                = Instance.new("Frame")
            thumb.Size                 = UDim2.new(0, 12, 0, 12)
            thumb.AnchorPoint          = Vector2.new(0.5, 0.5)
            thumb.Position             = UDim2.new((value-minV)/(maxV-minV), 0, 0.5, 0)
            thumb.BackgroundColor3     = Color3.new(1, 1, 1)
            thumb.ZIndex               = Z.Controls + 3
            thumb.Parent               = track
            corner(thumb, 6)
            local tS = stroke(thumb, T.Accent, 2)

            local function glowThumb(on)
                tw(thumb, 0.13, {Size = on and UDim2.new(0,15,0,15) or UDim2.new(0,12,0,12)})
                tw(tS, 0.13, {Color = on and T.AccentGlow or T.Accent})
            end

            local function setV(x)
                local p = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                value = math.floor(minV + p * (maxV - minV) + 0.5)
                local pn = (value - minV) / (maxV - minV)
                tw(fill,  0.04, {Size     = UDim2.new(pn, 0, 1, 0)})
                tw(thumb, 0.04, {Position = UDim2.new(pn, 0, 0.5, 0)})
                vLbl.Text = tostring(value) .. suf
                if c2.Callback then c2.Callback(value) end
            end

            track.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 then
                    glowThumb(true); setV(i.Position.X)
                    activeDragFn  = function(x) setV(x) end
                    activeDragEnd = function()
                        glowThumb(false)
                        Window:Notify({ Title=c2.Name or "Slider",
                            Content="Set to "..tostring(value)..suf, Duration=2 })
                    end
                end
            end)

            local Sl = {}
            function Sl:Set(v)
                value = math.clamp(v, minV, maxV)
                local pn = (value-minV)/(maxV-minV)
                tw(fill,  0.14, {Size = UDim2.new(pn,0,1,0)})
                tw(thumb, 0.14, {Position = UDim2.new(pn,0,0.5,0)})
                vLbl.Text = tostring(value)..suf
                if c2.Callback then c2.Callback(value) end
            end
            function Sl:Get() return value end
            if c2.Flag then Window.Flags[c2.Flag] = { Type="Slider", Set=Sl.Set, Get=Sl.Get } end
            return Sl
        end

        ---- DROPDOWN ----
        function Tab:AddDropdown(c2)
            c2 = c2 or {}
            local opts = c2.Options or {}
            local sel  = c2.Default or (opts[1] or "None")
            local open2 = false

            local card = newCard(44)
            local dS   = card:FindFirstChildOfClass("UIStroke")

            local nm = lbl(card, c2.Name or "Dropdown", 12,
                T.Text, Enum.Font.GothamSemibold, Enum.TextXAlignment.Left, Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(0.46, 0, 1, 0)
            nm.Position = UDim2.new(0, 10, 0, 0)

            local selB                 = Instance.new("TextButton")
            selB.Size                  = UDim2.new(0.48, -4, 0, 26)
            selB.Position              = UDim2.new(0.5, 2, 0.5, -13)
            selB.BackgroundColor3      = T.CardHover
            selB.Text                  = sel
            selB.TextColor3            = T.Accent
            selB.Font                  = Enum.Font.GothamSemibold
            selB.TextSize              = 11
            selB.AutoButtonColor       = false
            selB.ZIndex                = Z.Controls + 1
            selB.Parent                = card
            corner(selB, 6)
            pad(selB, 0, 0, 6, 18)

            local chev = lbl(selB, "▾", 10, T.TextMuted,
                Enum.Font.GothamBold, Enum.TextXAlignment.Right, Z.Controls+2)
            chev.Size = UDim2.new(1, -2, 1, 0)

            -- dropdown panel on overlay
            local dp                           = Instance.new("ScrollingFrame")
            dp.Size                            = UDim2.new(0, 0, 0, 0)
            dp.BackgroundColor3                = T.Panel
            dp.ClipsDescendants                = true
            dp.Active                          = true
            dp.ZIndex                          = Z.Dropdown
            dp.Visible                         = false
            dp.ScrollBarThickness              = 3
            dp.ScrollBarImageColor3            = T.Accent
            dp.ScrollBarImageTransparency      = 0.4
            dp.CanvasSize                      = UDim2.new(0, 0, 0, 0)
            dp.AutomaticCanvasSize             = Enum.AutomaticSize.Y
            dp.ScrollingDirection              = Enum.ScrollingDirection.Y
            dp.Parent                          = dropOverlay
            corner(dp, 7)
            stroke(dp, T.Accent, 1)
            pad(dp, 4, 4, 4, 4)

            local dpL       = Instance.new("UIListLayout")
            dpL.Padding     = UDim.new(0, 2)
            dpL.SortOrder   = Enum.SortOrder.LayoutOrder
            dpL.Parent      = dp

            local function closeD()
                if not open2 then return end
                open2 = false
                if activeDropClose == closeD then activeDropClose = nil end
                tw(dp, 0.13, {Size = UDim2.new(0, dp.AbsoluteSize.X, 0, 0)})
                task.delay(0.14, function() dp.Visible = false end)
                tw(chev, 0.13, {Rotation = 0})
                if dS then tw(dS, 0.13, {Color = T.Stroke}) end
            end

            local function buildOpts()
                for _, ch in pairs(dp:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                for i, opt in ipairs(opts) do
                    local ob                 = Instance.new("TextButton")
                    ob.Size                  = UDim2.new(1, 0, 0, 24)
                    ob.BackgroundColor3      = T.Card
                    ob.Text                  = opt
                    ob.TextColor3            = opt == sel and T.Accent or T.Text
                    ob.Font                  = Enum.Font.Gotham
                    ob.TextSize              = 11
                    ob.AutoButtonColor       = false
                    ob.LayoutOrder           = i
                    ob.ZIndex                = Z.Dropdown + 1
                    ob.Parent                = dp
                    corner(ob, 5)
                    ob.MouseEnter:Connect(function()
                        tw(ob, 0.09, {BackgroundColor3 = T.CardHover, TextColor3 = T.AccentGlow})
                    end)
                    ob.MouseLeave:Connect(function()
                        tw(ob, 0.09, {BackgroundColor3 = T.Card,
                            TextColor3 = opt == sel and T.Accent or T.Text})
                    end)
                    ob.MouseButton1Click:Connect(function()
                        if not Window._alive then return end
                        sel = opt; selB.Text = opt; closeD(); buildOpts()
                        Window:Notify({ Title=c2.Name or "Dropdown",
                            Content="Selected: "..opt, Duration=2 })
                        if c2.Callback then c2.Callback(opt) end
                    end)
                end
            end
            buildOpts()

            selB.MouseButton1Click:Connect(function()
                if not Window._alive then return end
                if open2 then closeD(); return end
                if activeDropClose and activeDropClose ~= closeD then activeDropClose() end
                open2 = true; activeDropClose = closeD

                local absPos  = selB.AbsolutePosition
                local absSize = selB.AbsoluteSize
                local panelW  = absSize.X + 6
                local panelH  = math.min(#opts * 28 + 10, 180)
                local screenH = workspace.CurrentCamera.ViewportSize.Y
                local openUp  = (screenH - (absPos.Y + absSize.Y)) < panelH + 10

                dp.Size     = UDim2.new(0, panelW, 0, 0)
                dp.CanvasPosition = Vector2.zero
                dp.Position = openUp
                    and UDim2.new(0, absPos.X, 0, absPos.Y - panelH - 4)
                    or  UDim2.new(0, absPos.X, 0, absPos.Y + absSize.Y + 4)
                dp.Visible = true
                tw(dp,   0.17, {Size = UDim2.new(0, panelW, 0, panelH)})
                tw(chev, 0.17, {Rotation = 180})
                if dS then tw(dS, 0.17, {Color = T.Accent}) end
            end)

            local DD = {}
            function DD:Set(v) sel=v; selB.Text=v; buildOpts() end
            function DD:Get() return sel end
            function DD:SetOptions(o) opts=o; buildOpts() end
            if c2.Flag then Window.Flags[c2.Flag] = { Type="Dropdown", Set=DD.Set, Get=DD.Get } end
            return DD
        end

        ---- INPUT ----
        function Tab:AddInput(c2)
            c2 = c2 or {}
            local card = newCard(54)
            local iS   = card:FindFirstChildOfClass("UIStroke")

            local nm = lbl(card, c2.Name or "Input", 12,
                T.Text, Enum.Font.GothamSemibold, Enum.TextXAlignment.Left, Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(1, -16, 0, 16)
            nm.Position = UDim2.new(0, 10, 0, 5)

            local field                = Instance.new("TextBox")
            field.Size                 = UDim2.new(1, -20, 0, 20)
            field.Position             = UDim2.new(0, 10, 0, 26)
            field.BackgroundColor3     = T.CardHover
            field.Text                 = c2.Default or ""
            field.PlaceholderText      = c2.Placeholder or "Enter value..."
            field.PlaceholderColor3    = T.TextMuted
            field.TextColor3           = T.Text
            field.Font                 = Enum.Font.Gotham
            field.TextSize             = 11
            field.TextXAlignment       = Enum.TextXAlignment.Left
            field.ClearTextOnFocus     = c2.ClearOnFocus or false
            field.ZIndex               = Z.Controls + 1
            field.Parent               = card
            corner(field, 6)
            pad(field, 0, 0, 6, 6)

            field.Focused:Connect(function()    if iS then tw(iS, 0.13, {Color = T.Accent}) end end)
            field.FocusLost:Connect(function(enter)
                if iS then tw(iS, 0.13, {Color = T.Stroke}) end
                if c2.Callback then c2.Callback(field.Text, enter) end
            end)

            local Inp = {}
            function Inp:Get() return field.Text end
            function Inp:Set(v) field.Text = v end
            if c2.Flag then Window.Flags[c2.Flag] = { Type="Input", Set=Inp.Set, Get=Inp.Get } end
            return Inp
        end

        ---- LABEL ----
        function Tab:AddLabel(text)
            local card = newCard(36)
            local l = lbl(card, text or "", 11, T.TextDim,
                Enum.Font.Gotham, Enum.TextXAlignment.Left, Z.Controls)
            l.Name = "NameLabel"
            l.Size = UDim2.new(1, -16, 1, 0)
            l.Position = UDim2.new(0, 10, 0, 0)
            l.TextWrapped = true
            local Lbl = {}
            function Lbl:Set(t) l.Text = t end
            return Lbl
        end

        ---- KEYBIND ----
        function Tab:AddKeybind(c2)
            c2 = c2 or {}
            local bind = c2.Default or Enum.KeyCode.Unknown
            local lstn = false

            local card = newCard(44)

            local nm = lbl(card, c2.Name or "Keybind", 12,
                T.Text, Enum.Font.GothamSemibold, Enum.TextXAlignment.Left, Z.Controls+1)
            nm.Name     = "NameLabel"
            nm.Size     = UDim2.new(1, -82, 1, 0)
            nm.Position = UDim2.new(0, 10, 0, 0)

            local kb                   = Instance.new("TextButton")
            kb.Size                    = UDim2.new(0, 60, 0, 22)
            kb.Position                = UDim2.new(1, -68, 0.5, -11)
            kb.BackgroundColor3        = T.CardHover
            kb.Text                    = bind.Name
            kb.TextColor3              = T.Accent
            kb.Font                    = Enum.Font.GothamBold
            kb.TextSize                = 10
            kb.AutoButtonColor         = false
            kb.ZIndex                  = Z.Controls + 1
            kb.Parent                  = card
            corner(kb, 5)

            kb.MouseButton1Click:Connect(function()
                lstn = true; kb.Text = "..."; kb.TextColor3 = T.Warning
            end)

            Window:_Connect(UserInputService.InputBegan, function(i, gp)
                if not lstn then return end
                if i.UserInputType == Enum.UserInputType.Keyboard then
                    lstn = false; bind = i.KeyCode
                    kb.Text = bind.Name; kb.TextColor3 = T.Accent
                    if not Window._alive then return end
                    Window:Notify({ Title=c2.Name or "Keybind",
                        Content="Bound to "..bind.Name, Duration=2 })
                    if c2.Callback then c2.Callback(bind) end
                end
            end)

            local KB = {}
            function KB:Get() return bind end
            function KB:Set(k) bind=k; kb.Text=k.Name end
            if c2.Flag then Window.Flags[c2.Flag] = { Type="Keybind", Set=KB.Set, Get=KB.Get } end
            return KB
        end

        return Tab
    end  -- CreateTab

    return Window
end  -- CreateWindow

