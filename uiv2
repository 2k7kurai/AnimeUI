    ------------------------------------------------------------------
    function Window:Notify(c2)
        if not self._alive then return end
        c2 = c2 or {}
        if not notifEnabled and not c2.Force then return end

        local ac = c2.Type == "success" and T.Success
                or c2.Type == "warn"    and T.Warning
                or c2.Type == "error"   and T.Danger
                or T.Accent

        local card                 = Instance.new("Frame")
        card.Size                  = UDim2.new(1, 0, 0, 64)
        card.BackgroundColor3      = T.Panel
        card.BackgroundTransparency = 0.05
        card.Position              = UDim2.new(-1.1, 0, 0, 0)
        card.ZIndex                = Z.Notif + 1
        card.Parent                = notifHolder
        corner(card, 10)
        stroke(card, ac, 1)

        local bar = Instance.new("Frame")
        bar.Size             = UDim2.new(0, 3, 1, -14)
        bar.Position         = UDim2.new(0, 0, 0, 7)
        bar.BackgroundColor3 = ac
        bar.BorderSizePixel  = 0
        bar.ZIndex           = Z.Notif + 2
        bar.Parent           = card
        corner(bar, 2)

        local nt = lbl(card, c2.Title or "Notification",
            13, T.Text, Enum.Font.GothamBold, Enum.TextXAlignment.Left, Z.Notif+2)
        nt.Size     = UDim2.new(1, -20, 0, 18)
        nt.Position = UDim2.new(0, 14, 0, 8)

        local nb = lbl(card, c2.Content or "",
            11, T.TextDim, Enum.Font.Gotham, Enum.TextXAlignment.Left, Z.Notif+2)
        nb.Size        = UDim2.new(1, -20, 0, 28)
        nb.Position    = UDim2.new(0, 14, 0, 26)
        nb.TextWrapped = true

        tw(card, 0.28, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Back)
        task.delay(c2.Duration or 4, function()
            tw(card, 0.22, {Position = UDim2.new(-1.1, 0, 0, 0)})
            task.delay(0.25, function() pcall(function() card:Destroy() end) end)
        end)
    end

