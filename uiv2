        BG=1, Overlay=2, Sidebar=10, Content=10,
        Controls=12, Topbar=20, Footer=20,
        MiniLogo=150, Notif=200, Dropdown=500, Tooltip=600,
    }

    local persist         = loadSettings()
    local notifEnabled    = persist.notificationsEnabled ~= false
    local miniLogoEnabled = persist.miniLogoEnabled      ~= false
    local savedBgId       = persist.backgroundId

    local function savePersist()
        persist.notificationsEnabled = notifEnabled
        persist.miniLogoEnabled      = miniLogoEnabled
        if savedBgId then persist.backgroundId = savedBgId end
        saveSettings(persist)
    end

    ----------------------------------------------------------------
    -- SCREEN GUI
    ----------------------------------------------------------------
    local gui              = Instance.new("ScreenGui")
    gui.Name               = "ZenithImmortalUI"
    gui.ResetOnSpawn       = false
    gui.ZIndexBehavior     = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder       = 999
    gui.IgnoreGuiInset     = true
    gui.Parent             = PlayerGui

    ----------------------------------------------------------------
    -- MAIN FRAME
    ----------------------------------------------------------------
    local main             = Instance.new("Frame")
    main.Name              = "Main"
    main.Size              = UDim2.new(0,WIN_W,0,WIN_H)
    main.Position          = UDim2.new(0.5,-WIN_W/2,0.5,-WIN_H/2)
    main.BackgroundColor3  = T.BG
    main.ClipsDescendants  = true
    main.Parent            = gui
    corner(main, RADIUS)

    local rimS = stroke(main, T.Accent, 1.2)
    local rimG = Instance.new("UIGradient")
    rimG.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0,   T.AccentDim),
        ColorSequenceKeypoint.new(0.4, T.Accent),
        ColorSequenceKeypoint.new(0.7, T.AccentGlow),
        ColorSequenceKeypoint.new(1,   T.AccentDim),
    })
    rimG.Rotation = 120
    rimG.Parent   = rimS

    -- Background image — UICorner + ClipsDescendants = zero bleed
    local bgImg                  = Instance.new("ImageLabel")
    bgImg.Size                   = UDim2.new(1,0,1,0)
    bgImg.BackgroundTransparency = 1
    bgImg.Image                  = savedBgId and ("rbxassetid://"..savedBgId)
                                             or cfg.Background or DEFAULT_BG
    bgImg.ImageTransparency      = 0.54
    bgImg.ScaleType              = Enum.ScaleType.Crop
    bgImg.ZIndex                 = Z.BG
    bgImg.Parent                 = main
    corner(bgImg, RADIUS)

    local bgOv                   = Instance.new("Frame")
    bgOv.Size                    = UDim2.new(1,0,1,0)
    bgOv.BackgroundColor3        = T.BG
    bgOv.BackgroundTransparency  = 0.3
    bgOv.ZIndex                  = Z.Overlay
    bgOv.Parent                  = main
    corner(bgOv, RADIUS)

    ----------------------------------------------------------------
    -- TOPBAR
    ----------------------------------------------------------------
    local topbar               = Instance.new("Frame")
    topbar.Name                = "Topbar"
    topbar.Size                = UDim2.new(1,0,0,TOP_H)
    topbar.BackgroundColor3    = T.Panel
    topbar.BackgroundTransparency = 0.06
    topbar.ZIndex              = Z.Topbar
    topbar.Parent              = main
    corner(topbar, RADIUS)

    -- gradient underline
    local topLine              = Instance.new("Frame")
