        local c=sig:Connect(cb); table.insert(self._connections,c); return c
    end

    ----------------------------------------------------------------
    -- NOTIFY
    ----------------------------------------------------------------
    function Window:Notify(c2)
        if not self._alive then return end
        c2=c2 or {}
        if not notifEnabled and not c2.Force then return end
        local ac = c2.Type=="success" and T.Success or c2.Type=="warn" and T.Warning
                or c2.Type=="error" and T.Danger or T.Accent

        local card=Instance.new("Frame")
        card.Size=UDim2.new(1,0,0,62); card.BackgroundColor3=T.Panel
        card.BackgroundTransparency=0.05; card.Position=UDim2.new(-1.1,0,0,0)
        card.ZIndex=Z.Notif+1; card.Parent=notifHolder
        corner(card,10); stroke(card,ac,1)

        local bar=Instance.new("Frame")
        bar.Size=UDim2.new(0,3,1,-14); bar.Position=UDim2.new(0,0,0,7)
        bar.BackgroundColor3=ac; bar.BorderSizePixel=0
        bar.ZIndex=Z.Notif+2; bar.Parent=card; corner(bar,2)

        local nt=lbl(card,c2.Title or "Notification",13,T.Text,Enum.Font.GothamBold,Enum.TextXAlignment.Left,Z.Notif+2)
        nt.Size=UDim2.new(1,-20,0,18); nt.Position=UDim2.new(0,14,0,8)
        local nb=lbl(card,c2.Content or "",11,T.TextDim,Enum.Font.Gotham,Enum.TextXAlignment.Left,Z.Notif+2)
        nb.Size=UDim2.new(1,-20,0,28); nb.Position=UDim2.new(0,14,0,26); nb.TextWrapped=true

        tw(card,0.28,{Position=UDim2.new(0,0,0,0)},Enum.EasingStyle.Back)
        task.delay(c2.Duration or 4,function()
            tw(card,0.22,{Position=UDim2.new(-1.1,0,0,0)})
            task.delay(0.25,function() pcall(function() card:Destroy() end) end)
        end)
    end

    ----------------------------------------------------------------
    -- UNLOAD
    ----------------------------------------------------------------
    function Window:Unload()
        if not self._alive then return end
        self._alive=false
        self:Notify({Title="Zenith Immortal",Content="UI Unloaded.",Type="warn",Duration=2,Force=true})
        task.delay(0.5,function()
            for _,c in ipairs(self._connections) do pcall(function() c:Disconnect() end) end
            pcall(function() gui:Destroy() end)
        end)
    end

    function Window:SetBackground(id)
        local n=tonumber(id)
        if n then savedBgId=n; persist.backgroundId=n; savePersist() end
        bgImg.Image="rbxassetid://"..tostring(id)
    end

    ----------------------------------------------------------------
    -- CONFIG
    ----------------------------------------------------------------
    local function ensureCfg() fsMkdir("ZenithImmortal"); fsMkdir(CONFIG_FOLDER) end

    function Window:SaveConfig(name)
        if not name or name=="" then self:Notify({Title="Config",Content="Name is empty.",Type="error",Duration=3}); return end
        ensureCfg()
        local data={}
        for flag,obj in pairs(self.Flags) do data[flag]=obj.Get() end
        local ok,enc=pcall(function() return HttpService:JSONEncode(data) end)
        if ok then fsWrite(CONFIG_FOLDER.."/"..name..".json",enc)
            self:Notify({Title="Config Saved",Content=name,Type="success",Duration=3}) end
    end

    function Window:LoadConfig(name)
        local path=CONFIG_FOLDER.."/"..name..".json"
        if not fsIs(path) then self:Notify({Title="Config Error",Content=name.." not found.",Type="error",Duration=3}); return end
        local ok,data=pcall(function() return HttpService:JSONDecode(fsRead(path)) end)
        if not ok then self:Notify({Title="Config Error",Content="Failed to parse.",Type="error",Duration=3}); return end
        for flag,value in pairs(data) do
            if self.Flags[flag] then pcall(function() self.Flags[flag].Set(value) end) end
        end
        self:Notify({Title="Config Loaded",Content=name,Type="success",Duration=3})
    end

    function Window:ListConfigs()
        ensureCfg()
        local names={}
        for _,f in ipairs(fsList(CONFIG_FOLDER)) do
            local n=f:match("([^/\\]+)%.json$"); if n then table.insert(names,n) end
        end
        return names
    end

    function Window:DeleteConfig(name)
        local path=CONFIG_FOLDER.."/"..name..".json"
        if fsIs(path) then fsDel(path)
            self:Notify({Title="Config Deleted",Content=name,Type="warn",Duration=3}) end
    end

    function Window:BuildConfigUI(tab)
        local cfgDD=tab:AddDropdown({Name="Select Config",Col="Left",Options=self:ListConfigs(),Default="(none)"})
        tab:AddButton({Name="Refresh List",Col="Right",Callback=function()
            local l=self:ListConfigs(); if #l==0 then l={"(none)"} end
            cfgDD:SetOptions(l); cfgDD:Set(l[1])
        end})
        local ni=tab:AddInput({Name="Config Name",Col="Left",Placeholder="my_config"})
        tab:AddButton({Name="Save",Col="Right",Callback=function()
            local n=ni:Get(); if n=="" then n=cfgDD:Get() end; self:SaveConfig(n)
            local l=self:ListConfigs(); if #l>0 then cfgDD:SetOptions(l) end
        end})
        tab:AddButton({Name="Load",Col="Left",Callback=function()
            local s=cfgDD:Get(); if s==""or s=="(none)"then s=ni:Get() end; self:LoadConfig(s)
        end})
        tab:AddButton({Name="Delete",Col="Right",Callback=function()
            local s=cfgDD:Get(); if s==""or s=="(none)"then s=ni:Get() end; self:DeleteConfig(s)
            local l=self:ListConfigs(); if #l==0 then l={"(none)"} end; cfgDD:SetOptions(l); cfgDD:Set(l[1])
        end})
